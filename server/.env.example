# =============================================================
# server/.env.example —— 复制为 .env 并填值
#
# 生产环境用法：
#   cp .env.example .env
#   # 然后填密钥（JWT_SECRET / AES_KEY 必须是高熵随机值）
#
# 生成密钥命令（在服务器跑）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # AES_KEY (必须 64 hex)
# =============================================================

# 服务端口
PORT=3000

# 运行环境（production 时隐藏详细错误）
NODE_ENV=production

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=scanfood
DB_PASSWORD=CHANGE_ME
DB_NAME=scanfood

# ---------- JWT ----------
# 必须 32 字符以上；缺失/过短会拒绝启动（jwt-secret.ts）
JWT_SECRET=CHANGE_ME_USE_RANDOM_BYTES_48_BASE64

# ---------- 微信小程序 ----------
WX_APP_ID=
WX_APP_SECRET=

# ---------- 上传 ----------
UPLOAD_PATH=./uploads

# ---------- AES-256-GCM (printer device_key 加密；32 字节 hex = 64 字符) ----------
AES_KEY=CHANGE_ME_USE_RANDOM_BYTES_32_HEX

# ---------- Web Push (VAPID 密钥对) ----------
# 一次性生成命令：
#   cd server && node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey); console.log('VAPID_PRIVATE_KEY='+k.privateKey);"
# 缺失时 web push 功能自动禁用（不影响启动）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@scanfood.local

# ---------- 邮件通知（平台默认 SMTP，店家配 custom 模式时不读这里） ----------
# 留空时仅 custom 模式可用（要求店主自己配 SMTP）
SMTP_PLATFORM_HOST=
SMTP_PLATFORM_PORT=465
SMTP_PLATFORM_USER=
SMTP_PLATFORM_PASS=
SMTP_PLATFORM_FROM=
SMTP_PLATFORM_SECURE=true

# ---------- Admin Web 基础 URL（用于邮件 / Web Push 跳转链接） ----------
# 留空时通知里不带"查看详情"按钮；填写后邮件/桌面通知点击会跳到该地址 + /orders?focus=<id>
# 例：https://scanfood-admin.com  或  https://116ca2f8.r19.cpolar.top
ADMIN_WEB_BASE_URL=

# ---------- 飞鹅云打印（可选） ----------
FEIE_USER=
FEIE_UKEY=
FEIE_API_BASE=https://api.feieyun.cn/Api/Open/

# ---------- 易联云打印（可选） ----------
YLY_CLIENT_ID=
YLY_CLIENT_SECRET=
YLY_API_BASE=https://open-api.10ss.net

# ---------- 中易云 365 打印（可选） ----------
ZYY_MEMBER_CODE=
ZYY_API_KEY=
ZYY_API_BASE=https://www.365cup.com/openapi

# ---------- 芯烨云打印（可选） ----------
XPRINTER_USER=
XPRINTER_USER_KEY=
XPRINTER_API_BASE=https://open.xpyun.net/api/openapi/xprinter

# ---------- 通知音色（可选） ----------
NOTIF_SOUND_BASE_URL=

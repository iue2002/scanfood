# =============================================================
# server/.env.example —— 复制为 .env 并填值
#
# 生产环境用法：
#   cp .env.example .env
#   # 然后填密钥（JWT_SECRET / AES_KEY 必须是高熵随机值）
#
# 生成密钥命令（在服务器跑）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # AES_KEY (必须 64 hex)
# =============================================================

# 服务端口
PORT=3000

# 运行环境（production 时隐藏详细错误）
NODE_ENV=production

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=scanfood
DB_PASSWORD=CHANGE_ME
DB_NAME=scanfood

# ---------- JWT ----------
# 必须 32 字符以上；缺失/过短会拒绝启动（jwt-secret.ts）
JWT_SECRET=CHANGE_ME_USE_RANDOM_BYTES_48_BASE64

# ---------- 微信小程序 ----------
WX_APP_ID=
WX_APP_SECRET=

# ---------- 上传 ----------
UPLOAD_PATH=./uploads

# ---------- Tinify 图片压缩（可选） ----------
TINIFY_API_KEY=

# ---------- AES-256-GCM (printer device_key 加密；32 字节 hex = 64 字符) ----------
AES_KEY=CHANGE_ME_USE_RANDOM_BYTES_32_HEX

# ---------- 飞鹅云打印（可选） ----------
FEIE_USER=
FEIE_UKEY=
FEIE_API_BASE=https://api.feieyun.cn/Api/Open/

# ---------- 易联云打印（可选） ----------
YLY_CLIENT_ID=
YLY_CLIENT_SECRET=
YLY_API_BASE=https://open-api.10ss.net

# ---------- 中易云 365 打印（可选） ----------
ZYY_MEMBER_CODE=
ZYY_API_KEY=
ZYY_API_BASE=https://www.365cup.com/openapi

# ---------- 芯烨云打印（可选） ----------
XPRINTER_USER=
XPRINTER_USER_KEY=
XPRINTER_API_BASE=https://open.xpyun.net/api/openapi/xprinter

# ---------- 通知音色（可选） ----------
NOTIF_SOUND_BASE_URL=

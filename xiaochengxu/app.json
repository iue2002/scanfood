{
  "pages": [
    "pages/order/order",
    "pages/me/me",
    "pages/orders-list/orders-list",
    "pages/confirm/confirm",
    "pages/detail/detail"
  ],
  "preloadRule": {
    "pages/order/order": {
      "network": "all",
      "packages": ["__APP__"]
    },
    "pages/me/me": {
      "network": "all",
      "packages": ["__APP__"]
    },
    "pages/orders-list/orders-list": {
      "network": "all",
      "packages": ["__APP__"]
    },
    "pages/confirm/confirm": {
      "network": "all",
      "packages": ["__APP__"]
    },
    "pages/detail/detail": {
      "network": "all",
      "packages": ["__APP__"]
    }
  },
  "window": {
    "navigationStyle": "custom",
    "backgroundColor": "#f8fafc",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#64748b",
    "selectedColor": "#2563eb",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/order/order",
        "text": "浏览"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "componentFramework": "glass-easel",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "sitemapLocation": "sitemap.json",
  "resizable": false,
  "darkmode": false
}

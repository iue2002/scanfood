/**app.wxss - 全局样式与响应式基础**/

/* ========== 页面基础配置 ========== */
page {
  /* Slate/Blue Theme Variables */
  --primary: #2563eb;        /* Blue 600 */
  --primary-light: #eff6ff;  /* Blue 50 */
  --bg-slate: #f8fafc;       /* Slate 50 */
  --text-main: #0f172a;      /* Slate 900 */
  --text-secondary: #334155; /* Slate 700 */
  --text-muted: #64748b;     /* Slate 500 */
  --border-color: #e5e7eb;   /* Gray 200 */
  --success: #10b981;        /* Emerald 500 */
  --danger: #ef4444;         /* Red 500 */
  --radius-xl: 24rpx;        /* modern rounded corners */

  /* TabBar 实际高度（用 calc 在子组件里加上安全区）：
   * custom-tab-bar 内容 ≈ 100rpx，padding 上下 8rpx 8rpx，下边再加 safe-area-inset-bottom
   * 取 116rpx 作为 TabBar 内容总高（不含安全区），子 sheet 用 var(--tabbar-h) 避让
   */
  --tabbar-h: 116rpx;

  height: 100%;
  background: var(--bg-slate);
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  color: var(--text-main);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* ========== 容器布局 ========== */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ========== 通用按钮样式 ========== */
button {
  border: none;
  outline: none;
  background: transparent;
  padding: 0;
  margin: 0;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

/* ========== 通用弹性布局类 ========== */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

.flex-1 {
  flex: 1;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-around {
  justify-content: space-around;
}

/* ========== 通用间距类 ========== */
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }

.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

.ml-1 { margin-left: 8rpx; }
.ml-2 { margin-left: 16rpx; }
.ml-3 { margin-left: 24rpx; }

.mr-1 { margin-right: 8rpx; }
.mr-2 { margin-right: 16rpx; }
.mr-3 { margin-right: 24rpx; }

.p-1 { padding: 8rpx; }
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }

/* ========== 文字溢出处理 ========== */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  word-break: break-all;
}

/* ========== 文字大小 ========== */
.text-xs { font-size: 20rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 40rpx; }

/* ========== 文字颜色 ========== */
.text-primary { color: var(--text-main); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-accent { color: var(--primary); }
.text-success { color: var(--success); }

/* ========== 安全区域适配 ========== */
.safe-area-top {
  padding-top: env(safe-area-inset-top);
  padding-top: constant(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
  padding-bottom: constant(safe-area-inset-bottom);
}

/* ========== 通用卡片样式 ========== */
.card {
  background: #fff;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  padding: 24rpx;
  border-bottom: 2rpx solid var(--border-color);
}

/* ========== 触控区域最小尺寸 ========== */
.touch-target {
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 图片自适应 ========== */
image {
  width: 100%;
  height: 100%;
  display: block;
}

.img-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-contain {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* ========== 加载状态 ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  text-align: center;
}

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

.divider-vertical {
  width: 1rpx;
  background: #f0f0f0;
  margin: 0 16rpx;
}

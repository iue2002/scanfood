<!--components/confirm-sheet/index.wxml — 全屏"确认订单"弹窗-->
<view
  wx:if="{{visible}}"
  class="om-sheet-root {{sheetIn ? 'om-sheet-root-in' : ''}}"
>
  <!-- 自绘顶栏（带返回） -->
  <view class="om-navbar" style="padding-top: {{statusBarHeight || 20}}px;">
    <view class="om-navbar-inner">
      <view class="om-navbar-back" bindtap="onClose" hover-class="om-navbar-back-hover">
        <text class="om-navbar-back-arrow">‹</text>
      </view>
      <text class="om-navbar-title">确认订单</text>
    </view>
  </view>

  <!-- 滚动主体 -->
  <scroll-view class="om-page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 菜品明细卡 -->
    <view class="om-card">
      <view class="om-card-head">
        <text class="om-card-title">菜品明细</text>
        <text class="om-card-count">{{order.order_items.length}} 项</text>
      </view>
      <view class="om-items">
        <view class="om-item" wx:for="{{order.order_items}}" wx:key="id">
          <view class="om-item-name-wrap">
            <text class="om-item-name">{{item.dish_name}}</text>
            <text class="om-item-qty">×{{item.quantity}}</text>
          </view>
          <text class="om-item-subtotal">¥{{item.subtotal}}</text>
        </view>
      </view>
      <view class="om-total-row">
        <text class="om-total-label">合计</text>
        <view class="om-total-amount-wrap">
          <text class="om-total-symbol">¥</text>
          <text class="om-total-num">{{order.total_amount}}</text>
        </view>
      </view>
    </view>

    <!-- 用餐信息卡 -->
    <view class="om-card">
      <view class="om-card-head">
        <text class="om-card-title">用餐信息</text>
      </view>
      <view class="om-form-row">
        <text class="om-form-label">用餐人数</text>
        <picker bindchange="onPeopleChange" value="{{peopleIndex}}" range="{{peopleRange}}">
          <view class="om-form-picker">
            <text>{{peopleRange[peopleIndex]}} 人</text>
            <text class="om-form-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="om-form-row om-form-row-textarea">
        <text class="om-form-label">订单备注</text>
        <view class="om-input-wrap">
          <input
            class="om-input"
            placeholder="请填写备注（如微辣、少放盐）"
            placeholder-class="om-input-placeholder"
            bindinput="onRemarkInput"
            value="{{remark}}"
          />
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部提交栏 -->
  <view class="om-footer">
    <view class="om-footer-info">
      <text class="om-footer-count">共 {{order.order_items.length}} 项</text>
      <view class="om-footer-amount">
        <text class="om-footer-symbol">¥</text>
        <text class="om-footer-num">{{order.total_amount}}</text>
      </view>
    </view>
    <view
      class="om-footer-submit {{isSubmitting ? 'om-footer-submit-disabled' : ''}}"
      bindtap="submitOrder"
      hover-class="om-footer-submit-hover"
    >
      {{isSubmitting ? '提交中…' : '提交订单'}}
    </view>
  </view>
</view>

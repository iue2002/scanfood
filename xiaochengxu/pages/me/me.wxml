<!--pages/me/me.wxml — 商家端主题对齐版（仅视觉重构）-->
<view class="om-page">

  <!-- 用户卡片：admin-web Sidebar 头部同款 logo + 用户名 + 副标题 -->
  <view class="om-userblock">
    <view class="om-user-card" wx:if="{{userInfo}}" bindtap="showAuthModal">
      <image
        wx:if="{{userInfo.avatar_url || userInfo.avatarUrl}}"
        class="om-avatar"
        src="{{userInfo.avatar_url || userInfo.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="om-avatar om-avatar-placeholder">
        <text class="om-avatar-glyph">👤</text>
      </view>
      <view class="om-user-detail">
        <text class="om-user-name">{{userInfo.nickname || userInfo.nickName || '微信用户'}}</text>
        <text class="om-user-meta">ID · {{userInfo.id || '-'}}</text>
      </view>
      <text class="om-user-arrow">›</text>
    </view>
    <view class="om-user-card" wx:else bindtap="showAuthModal">
      <view class="om-avatar om-avatar-placeholder">
        <text class="om-avatar-glyph">👤</text>
      </view>
      <view class="om-user-detail">
        <text class="om-user-name">点击登录</text>
        <text class="om-user-meta">登录后查看订单记录</text>
      </view>
      <text class="om-user-arrow">›</text>
    </view>
  </view>

  <!-- 功能入口（admin-web Sidebar nav-link 风格） -->
  <view class="om-menu" wx:if="{{userInfo}}">
    <view class="om-menu-item" bindtap="goToOrders" hover-class="om-menu-item-hover">
      <view class="om-menu-icon om-menu-icon-orders">
        <text class="om-menu-icon-glyph">📋</text>
      </view>
      <view class="om-menu-text">
        <text class="om-menu-title">我的订单</text>
        <text class="om-menu-desc">查看历史订单与状态</text>
      </view>
      <text class="om-menu-arrow">›</text>
    </view>
  </view>

  <!-- 未登录态 -->
  <view class="om-empty" wx:if="{{!userInfo}}">
    <view class="om-empty-icon">
      <text class="om-empty-icon-glyph">🔐</text>
    </view>
    <view class="om-empty-title">请先登录</view>
    <view class="om-empty-desc">登录后查看您的订单记录</view>
    <view class="om-empty-cta" bindtap="showAuthModal" hover-class="om-empty-cta-hover">立即登录</view>
  </view>

  <!-- 版本信息（admin-web Sidebar 底部 v1.0 同款）-->
  <view class="om-version">扫码点餐 · v1.0</view>

  <!-- 授权弹窗 -->
  <view class="om-auth-modal" wx:if="{{showAuthModal}}">
    <view class="om-modal-mask" bindtap="hideAuthModal"></view>
    <view class="om-modal-card">
      <view class="om-modal-head">
        <text class="om-modal-title">用户信息授权</text>
      </view>
      <view class="om-modal-body">
        <text class="om-auth-section-title">我们需要获取您的以下信息</text>
        <view class="om-auth-item">
          <view class="om-auth-icon"><text>👤</text></view>
          <view class="om-auth-text">
            <text class="om-auth-text-main">微信昵称</text>
            <text class="om-auth-text-sub">用于显示您的用户名</text>
          </view>
        </view>
        <view class="om-auth-item">
          <view class="om-auth-icon"><text>🖼️</text></view>
          <view class="om-auth-text">
            <text class="om-auth-text-main">微信头像</text>
            <text class="om-auth-text-sub">用于个性化展示</text>
          </view>
        </view>
        <view class="om-auth-notice">
          <text class="om-auth-notice-icon">🔒</text>
          <text class="om-auth-notice-text">我们承诺保护您的隐私安全，获取的信息仅用于小程序内展示，不会泄露给第三方。</text>
        </view>
      </view>
      <view class="om-modal-foot">
        <button class="om-btn-cancel" bindtap="hideAuthModal">暂不授权</button>
        <button class="om-btn-confirm" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">同意并授权</button>
      </view>
    </view>
  </view>

  <!-- 昵称输入弹窗 -->
  <view class="om-auth-modal" wx:if="{{showNicknameModal}}">
    <view class="om-modal-mask" bindtap="hideNicknameModal"></view>
    <view class="om-modal-card">
      <view class="om-modal-head">
        <text class="om-modal-title">设置昵称</text>
      </view>
      <view class="om-modal-body">
        <view class="om-input-wrap">
          <input
            class="om-input"
            type="nickname"
            placeholder="请输入您的昵称"
            placeholder-class="om-input-placeholder"
            value="{{tempNickname}}"
            bindinput="onNicknameInputChange"
            focus="{{showNicknameModal}}"
          />
        </view>
      </view>
      <view class="om-modal-foot">
        <button class="om-btn-cancel" bindtap="hideNicknameModal">取消</button>
        <button class="om-btn-confirm" bindtap="confirmLogin">确认登录</button>
      </view>
    </view>
  </view>
</view>

<!--pages/me/me.wxml-->
<view class="me-container">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="user-card" wx:if="{{userInfo}}" bindtap="showAuthModal">
      <image wx:if="{{userInfo.avatar_url || userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatar_url || userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-placeholder">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-detail">
        <view class="user-name">{{userInfo.nickname || userInfo.nickName || '微信用户'}}</view>
        <view class="user-id">ID: {{userInfo.id || '未登录'}}</view>
      </view>
    </view>
    <view class="user-card" wx:else bindtap="showAuthModal">
      <view class="avatar avatar-placeholder">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-detail">
        <view class="user-name">点击登录</view>
        <view class="user-id">登录后查看订单记录</view>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section" wx:if="{{userInfo}}">
    <view class="menu-item" bindtap="goToOrders">
      <view class="menu-icon">📋</view>
      <view class="menu-text">我的订单</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="empty" wx:if="{{!userInfo}}">
    <view class="empty-icon">🔐</view>
    <view class="empty-text">请先登录</view>
    <view class="empty-desc">登录后查看您的订单记录</view>
    <view class="login-btn" bindtap="showAuthModal">立即登录</view>
  </view>

  <!-- 授权弹窗 -->
  <view class="auth-modal" wx:if="{{showAuthModal}}">
    <view class="modal-mask" bindtap="hideAuthModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">用户信息授权</text>
      </view>
      <view class="modal-body">
        <view class="auth-desc">
          <text class="desc-title">我们需要获取您的以下信息：</text>
          <view class="desc-item">
            <text class="item-icon">👤</text>
            <text class="item-text">微信昵称 - 用于显示您的用户名</text>
          </view>
          <view class="desc-item">
            <text class="item-icon">🖼️</text>
            <text class="item-text">微信头像 - 用于个性化展示</text>
          </view>
        </view>
        <view class="auth-notice">
          <text class="notice-icon">🔒</text>
          <text class="notice-text">我们承诺保护您的隐私安全，获取的信息仅用于小程序内展示，不会泄露给第三方。</text>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="hideAuthModal">暂不授权</button>
        <button class="btn-confirm" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          同意并授权
        </button>
      </view>
    </view>
  </view>

  <!-- 昵称输入弹窗 -->
  <view class="nickname-modal" wx:if="{{showNicknameModal}}">
    <view class="modal-mask" bindtap="hideNicknameModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">设置昵称</text>
      </view>
      <view class="modal-body">
        <input class="nickname-input-modal" type="nickname" placeholder="请输入您的昵称" value="{{tempNickname}}" bindinput="onNicknameInputChange" focus="{{showNicknameModal}}" />
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="hideNicknameModal">取消</button>
        <button class="btn-confirm" bindtap="confirmLogin">确认登录</button>
      </view>
    </view>
  </view>
</view>

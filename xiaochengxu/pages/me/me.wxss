/* pages/me/me.wxss */
.me-container {
  min-height: 100vh;
  background: #ededed;
  padding-bottom: 120rpx;
}

/* ===== 用户信息头部 ===== */
.user-header {
  background: #fff;
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
}

.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 2rpx solid #e5e5e5;
  box-sizing: border-box;
}

.avatar-placeholder {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e5e5e5;
}

.avatar-icon {
  font-size: 56rpx;
  color: #c5c5c5;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 26rpx;
  color: #b0b0b0;
}

/* ===== 功能菜单区域 ===== */
.menu-section {
  background: #fff;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f5f5f5;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  margin-right: 20rpx;
  width: 48rpx;
  height: 48rpx;
}

.menu-line {
  width: 32rpx;
  height: 4rpx;
  background: #1a1a1a;
  border-radius: 2rpx;
}

.menu-text {
  font-size: 32rpx;
  color: #000;
}

.menu-arrow {
  font-size: 32rpx;
  color: #c5c5c5;
}

/* ===== 未登录状态 ===== */
.empty {
  text-align: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #000;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #b0b0b0;
  margin-bottom: 48rpx;
}

.login-btn {
  display: inline-block;
  background: #07c160;
  color: #fff;
  padding: 20rpx 80rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
}

/* ===== 弹窗样式 ===== */
.auth-modal,
.nickname-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx 28rpx 20rpx;
  text-align: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
}

.modal-body {
  padding: 28rpx;
}

.auth-desc {
  margin-bottom: 28rpx;
}

.desc-title {
  display: block;
  font-size: 28rpx;
  color: #000;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.desc-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.item-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}

.item-text {
  font-size: 26rpx;
  color: #666;
}

.auth-notice {
  display: flex;
  align-items: flex-start;
  background: #f7f7f7;
  padding: 18rpx;
  border-radius: 8rpx;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #e5e5e5;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
}

.btn-cancel {
  color: #000;
  background: #fff;
}

.btn-confirm {
  color: #07c160;
  background: #fff;
  font-weight: 600;
}

.btn-cancel::after,
.btn-confirm::after {
  border: none;
}

/* 昵称输入框 */
.nickname-input-modal {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.nickname-input-modal:focus {
  border-color: #07c160;
}

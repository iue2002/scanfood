/* pages/me/me.wxss */
.me-container {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 120rpx;
}

/* 用户信息头部 */
.user-header {
  background: #fff;
  padding: 60rpx 32rpx 80rpx;
}

.user-card {
  background: #f7f7f7;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
  border: 2rpx solid #eee;
}

.avatar-placeholder {
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 56rpx;
  color: #ccc;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 0.3rpx;
}

/* 功能菜单 */
.menu-section {
  margin: -50rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.2;
}

.empty-text {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.login-btn {
  display: inline-block;
  background: #1a1a1a;
  color: #fff;
  padding: 20rpx 64rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 授权弹窗 */
.auth-modal,
.nickname-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx 28rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.modal-body {
  padding: 28rpx;
}

.auth-desc {
  margin-bottom: 28rpx;
}

.desc-title {
  display: block;
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.desc-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.item-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
}

.item-text {
  font-size: 26rpx;
  color: #666;
}

.auth-notice {
  display: flex;
  align-items: flex-start;
  background: #f8f9fa;
  padding: 18rpx;
  border-radius: 12rpx;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  font-weight: 500;
}

.btn-cancel {
  color: #999;
  background: #fff;
}

.btn-confirm {
  color: #fff;
  background: #1a1a1a;
}

.btn-cancel::after,
.btn-confirm::after {
  border: none;
}

/* 昵称输入框 */
.nickname-input-modal {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.nickname-input-modal:focus {
  border-color: #1a1a1a;
}

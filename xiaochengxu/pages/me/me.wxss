/* pages/me/me.wxss */
.me-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 用户信息头部 */
.user-header {
  background: linear-gradient(135deg, #ff9d00 0%, #ff6b35 100%);
  padding: 40rpx 24rpx 60rpx;
}

.user-card {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-placeholder {
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 50rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 功能菜单 */
.menu-section {
  margin: -40rpx 20rpx 12rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.login-btn {
  display: inline-block;
  background: linear-gradient(135deg, #ff9d00 0%, #ff6b35 100%);
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(255, 157, 0, 0.3);
}

/* 授权弹窗 */
.auth-modal,
.nickname-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 28rpx 24rpx 16rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 24rpx;
}

.auth-desc {
  margin-bottom: 24rpx;
}

.desc-title {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.desc-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.item-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.item-text {
  font-size: 24rpx;
  color: #666;
}

.auth-notice {
  display: flex;
  align-items: flex-start;
  background: #f8f9fa;
  padding: 16rpx;
  border-radius: 10rpx;
}

.notice-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
}

.btn-cancel {
  color: #999;
  background: #fff;
}

.btn-confirm {
  color: #fff;
  background: #ff9d00;
}

.btn-cancel::after,
.btn-confirm::after {
  border: none;
}

/* 昵称输入框 */
.nickname-input-modal {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 16rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.nickname-input-modal:focus {
  border-color: #ff9d00;
}

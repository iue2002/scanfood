/* pages/me/me.wxss — admin-web 主题对齐 */

.om-page {
  min-height: 100vh;
  background: #F8FAFC;
  padding: 24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  color: #0F172A;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* ====== 用户卡 ====== */
.om-userblock {
  margin-bottom: 24rpx;
}
.om-user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.04);
}
.om-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #EFF6FF;
  flex-shrink: 0;
  display: block;
}
.om-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #DBEAFE 0%, #93C5FD 100%);
}
.om-avatar-letter {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  letter-spacing: 0.5rpx;
  text-transform: uppercase;
}
.om-user-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.om-user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
  letter-spacing: 0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.om-user-meta {
  font-size: 22rpx;
  color: #94A3B8;
}
.om-user-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  flex-shrink: 0;
  line-height: 1;
}

/* ====== 菜单 ====== */
.om-menu {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.04);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.om-menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-top: 2rpx solid #F1F5F9;
}
.om-menu-item:first-child {
  border-top: none;
}
.om-menu-item-hover {
  background: #F8FAFC;
}
.om-menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.om-menu-icon-orders {
  background: #EFF6FF;
}

/* 列表线条图标 (lucide ClipboardList 简化版) */
.om-icon-list {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  align-items: center;
}
.om-icon-list-line {
  width: 22rpx;
  height: 3rpx;
  background: #2563EB;
  border-radius: 2rpx;
}
.om-icon-list-line:nth-child(2) { width: 18rpx; }
.om-icon-list-line:nth-child(3) { width: 14rpx; }
.om-menu-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.om-menu-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #0F172A;
}
.om-menu-desc {
  font-size: 22rpx;
  color: #94A3B8;
}
.om-menu-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  line-height: 1;
}

/* ====== 空态 ====== */
.om-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx 40rpx;
  gap: 12rpx;
}
.om-empty-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 9999rpx;
  background: #EFF6FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

/* 锁形线条图标 (lucide Lock 简化版) */
.om-icon-lock {
  position: relative;
  width: 56rpx;
  height: 60rpx;
}
.om-icon-lock-shackle {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 28rpx;
  border: 4rpx solid #2563EB;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
  box-sizing: border-box;
}
.om-icon-lock-body {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 56rpx;
  height: 36rpx;
  background: #2563EB;
  border-radius: 6rpx;
}
.om-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
}
.om-empty-desc {
  font-size: 26rpx;
  color: #64748B;
}
.om-empty-cta {
  margin-top: 24rpx;
  height: 80rpx;
  padding: 0 64rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
  letter-spacing: 0.5rpx;
}
.om-empty-cta-hover { background: #1D4ED8; }

/* ====== 版本号 ====== */
.om-version {
  text-align: center;
  font-size: 22rpx;
  color: #94A3B8;
  padding: 12rpx 0;
  letter-spacing: 0.5rpx;
}

/* ====== 弹窗 ====== */
.om-auth-modal {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.om-modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
}
.om-modal-card {
  position: relative;
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.2);
  overflow: hidden;
}
.om-modal-head {
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 2rpx solid #F1F5F9;
}
.om-modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  letter-spacing: 0.3rpx;
}
.om-modal-body {
  padding: 24rpx 32rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 授权说明 */
.om-auth-section-title {
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 4rpx;
}
.om-auth-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  border: 2rpx solid #F1F5F9;
}
.om-auth-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.om-auth-text-main {
  font-size: 26rpx;
  color: #0F172A;
  font-weight: 500;
}
.om-auth-text-sub {
  font-size: 22rpx;
  color: #94A3B8;
}
.om-auth-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  background: #EFF6FF;
  border-radius: 14rpx;
  margin-top: 8rpx;
}
.om-auth-notice-text {
  flex: 1;
  font-size: 22rpx;
  color: #2563EB;
  line-height: 1.5;
}

/* 输入框 */
.om-input-wrap {
  background: #F8FAFC;
  border: 2rpx solid #F1F5F9;
  border-radius: 16rpx;
  padding: 0 20rpx;
}
.om-input {
  width: 100%;
  height: 96rpx;
  font-size: 28rpx;
  color: #0F172A;
  background: transparent;
}
.om-input-placeholder {
  color: #94A3B8;
}

/* 弹窗底栏 */
.om-modal-foot {
  display: flex;
  border-top: 2rpx solid #F1F5F9;
}
.om-btn-cancel,
.om-btn-confirm {
  flex: 1;
  height: 96rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 0;
  line-height: 96rpx;
  text-align: center;
}
.om-btn-cancel {
  color: #64748B;
  border-right: 2rpx solid #F1F5F9;
}
.om-btn-confirm {
  color: #2563EB;
  font-weight: 600;
}
.om-btn-cancel::after,
.om-btn-confirm::after {
  border: none;
}

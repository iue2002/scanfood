<!--pages/order/cart.wxml-->
<view class="cart-container">
  <!-- 顶部信息 -->
  <view class="header-bar">
    <view class="table-info">
      <block wx:if="{{tableNumber}}">
        <text class="table-num">{{tableNumber}}</text>
        <text class="table-label">号桌</text>
      </block>
    </view>
    <view class="header-actions">
      <view class="action-btn" wx:if="{{cartItems.length > 0}}" catchtap="clearCart">清空</view>
      <view class="close-btn" catchtap="goBack">✕</view>
    </view>
  </view>

  <!-- 空购物车 -->
  <view class="empty" wx:if="{{cartItems.length === 0}}">
    <view class="empty-icon">🛒</view>
    <view class="empty-text">购物车是空的</view>
    <view class="empty-desc">快去选择喜欢的菜品吧~</view>
    <view class="go-back-btn" catchtap="goBack">去点餐</view>
  </view>

  <!-- 购物车列表 -->
  <scroll-view class="cart-list" scroll-y wx:if="{{cartItems.length > 0}}">
    <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
      <image class="item-image" src="{{item.image_url || '/images/default-dish.png'}}" mode="aspectFill"></image>
      <view class="item-info">
        <view class="item-name">{{item.dish_name}}</view>
        <view class="item-price">¥{{item.price}}</view>
        <view class="item-bottom">
          <view class="quantity-control">
            <view class="minus" catchtap="updateQuantity" data-id="{{item.id}}" data-type="minus">
              <text wx:if="{{item.quantity > 1}}">-</text>
              <text wx:else class="delete-icon">🗑</text>
            </view>
            <view class="quantity">{{item.quantity}}</view>
            <view class="plus" catchtap="updateQuantity" data-id="{{item.id}}" data-type="plus">+</view>
          </view>
          <view class="item-subtotal">¥{{item.subtotal}}</view>
        </view>
      </view>
    </view>
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部结算栏 -->
  <view class="footer-bar" wx:if="{{cartItems.length > 0}}">
    <view class="footer-info">
      <view class="total-count">共 {{totalCount}} 件</view>
      <view class="total-amount">¥{{totalPrice}}</view>
    </view>
    <view class="submit-btn" catchtap="goToConfirm">{{isAddMore ? '提交加餐' : '去下单'}}</view>
  </view>
</view>

/* pages/order/cart.wxss — admin-web 主题对齐 */

.om-page {
  min-height: 100vh;
  background: #F8FAFC;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  color: #0F172A;
  font-size: 28rpx;
  line-height: 1.5;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ====== 顶部 ====== */
.om-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F1F5F9;
}
.om-topbar-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}
.om-table-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.1;
  letter-spacing: 0.5rpx;
}
.om-table-suffix {
  font-size: 24rpx;
  color: #94A3B8;
}
.om-topbar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.om-btn-clear {
  height: 56rpx;
  padding: 0 22rpx;
  background: #FEF2F2;
  color: #EF4444;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  border: 2rpx solid #FEE2E2;
}
.om-btn-clear-hover { background: #FEE2E2; }
.om-btn-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #F1F5F9;
  color: #64748B;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.om-btn-close-hover { background: #E2E8F0; }

/* ====== 列表 ====== */
.om-list {
  padding: 16rpx 32rpx 0;
  height: calc(100vh - 96rpx - 160rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ====== 卡片 ====== */
.om-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.04);
}
.om-card:first-child { margin-top: 0; }

.om-card-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #F8FAFC;
  flex-shrink: 0;
  display: block;
}
.om-card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8rpx;
}
.om-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  line-height: 1.3;
  letter-spacing: 0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.om-card-price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.om-card-price-symbol {
  font-size: 22rpx;
  color: #64748B;
}
.om-card-price-num {
  font-size: 26rpx;
  color: #64748B;
  font-weight: 500;
}
.om-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}
.om-card-subtotal {
  font-size: 32rpx;
  font-weight: 700;
  color: #2563EB;
  letter-spacing: 0.3rpx;
}

/* 步进器 */
.om-step {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.om-step-minus,
.om-step-plus {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  border-radius: 12rpx;
  font-weight: 500;
  transition: background 0.15s, opacity 0.15s;
}
.om-step-minus {
  background: #F1F5F9;
  color: #334155;
  border: 2rpx solid #E5E7EB;
}
.om-step-minus-hover { background: #E2E8F0; }
.om-step-plus {
  background: #2563EB;
  color: #FFFFFF;
}
.om-step-plus-hover { background: #1D4ED8; }
.om-step-count {
  min-width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  padding: 0 8rpx;
}

.om-bottom-spacer {
  height: 32rpx;
}

/* ====== 底部结算栏 ====== */
.om-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #F1F5F9;
  z-index: 50;
}
.om-footer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.om-footer-count {
  font-size: 22rpx;
  color: #94A3B8;
}
.om-footer-amount {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.om-footer-symbol {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F172A;
}
.om-footer-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2563EB;
  letter-spacing: 0.5rpx;
  line-height: 1.1;
}
.om-footer-submit {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 48rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5rpx;
}
.om-footer-submit-hover {
  background: #1D4ED8;
}

/* ====== 空态 ====== */
.om-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 32rpx;
  gap: 16rpx;
}
.om-empty-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 9999rpx;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

/* 购物车线条图标 (lucide ShoppingCart 简化版) */
.om-icon-cart {
  position: relative;
  width: 64rpx;
  height: 64rpx;
}
.om-icon-cart-handle {
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  width: 14rpx;
  height: 4rpx;
  background: #94A3B8;
  border-radius: 2rpx;
}
.om-icon-cart-body {
  position: absolute;
  top: 16rpx;
  left: 8rpx;
  width: 44rpx;
  height: 28rpx;
  border: 4rpx solid #94A3B8;
  border-radius: 4rpx 8rpx 4rpx 4rpx;
  box-sizing: border-box;
  background: transparent;
}
.om-icon-cart-wheel {
  position: absolute;
  bottom: 4rpx;
  left: 16rpx;
  width: 8rpx;
  height: 8rpx;
  background: #94A3B8;
  border-radius: 50%;
}
.om-icon-cart-wheel-2 {
  left: 40rpx;
}
.om-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
}
.om-empty-desc {
  font-size: 26rpx;
  color: #64748B;
}
.om-empty-cta {
  margin-top: 24rpx;
  height: 80rpx;
  padding: 0 56rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
  letter-spacing: 0.5rpx;
}
.om-empty-cta-hover { background: #1D4ED8; }

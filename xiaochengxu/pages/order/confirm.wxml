<!--pages/order/confirm.wxml-->
<view class="confirm-container">
  <view class="section">
    <view class="section-title">菜品明细</view>
    <view wx:for="{{order.order_items}}" wx:key="id" class="item">
      <view class="name">{{item.dish_name}}</view>
      <view class="qty">x{{item.quantity}}</view>
      <view class="price">￥{{item.subtotal}}</view>
    </view>
    <view class="total-row">
      <text>合计</text>
      <text class="total-price">￥{{order.total_amount}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">用餐信息</view>
    <view class="form-item">
      <text class="label">用餐人数</text>
      <picker bindchange="onPeopleChange" value="{{peopleIndex}}" range="{{peopleRange}}">
        <view class="picker">{{peopleRange[peopleIndex]}}人</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">订单备注</text>
      <input class="input" placeholder="请填写备注（如微辣、少放盐）" bindinput="onRemarkInput" value="{{remark}}" />
    </view>
  </view>

  <view class="footer">
    <view class="total">共 {{order.order_items.length}} 项，￥{{order.total_amount}}</view>
    <button type="primary" class="submit-btn" bindtap="submitOrder">提交订单</button>
  </view>
</view>

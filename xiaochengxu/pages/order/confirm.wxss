/* pages/order/confirm.wxss */
.confirm-container {
  padding: 20rpx;
  background: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

.section {
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.name {
  flex: 1;
}

.qty {
  width: 80rpx;
  text-align: center;
}

.price {
  width: 120rpx;
  text-align: right;
  color: #333;
}

.total-row {
  border-top: 1rpx solid #eee;
  padding-top: 12rpx;
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: bold;
}

.total-price {
  color: #ff4d4f;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #333;
}

.picker {
  font-size: 26rpx;
  color: #666;
}

.input {
  text-align: right;
  font-size: 26rpx;
  flex: 1;
  margin-left: 20rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 90rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}

.total {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.submit-btn {
  width: 200rpx !important;
  margin: 0 !important;
  border-radius: 40rpx !important;
  font-size: 28rpx !important;
  background: #ff9d00 !important;
}

/* pages/order/confirm.wxss */
.confirm-container {
  padding: 24rpx;
  background: #f7f7f7;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: #666;
  letter-spacing: 0.3rpx;
}

.name {
  flex: 1;
}

.qty {
  width: 80rpx;
  text-align: center;
}

.price {
  width: 120rpx;
  text-align: right;
  color: #1a1a1a;
  font-weight: 500;
}

.total-row {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.total-price {
  color: #1a1a1a;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

.picker {
  font-size: 28rpx;
  color: #666;
}

.input {
  text-align: right;
  font-size: 28rpx;
  flex: 1;
  margin-left: 20rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  padding-right: 28rpx;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.total {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.submit-btn {
  width: 220rpx !important;
  margin: 0 !important;
  border-radius: 50rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  background: #1a1a1a !important;
  letter-spacing: 1rpx !important;
}

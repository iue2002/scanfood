/* pages/order/confirm.wxss - 订单确认页面响应式适配 */

/* ========== 容器布局 ========== */
.confirm-container {
  padding: 24rpx;
  background: #f7f7f7;
  min-height: 100vh;
  padding-bottom: 120rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========== 通用区块 ========== */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ========== 订单项 ========== */
.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: #666;
  letter-spacing: 0.3rpx;
  min-height: 60rpx;
  box-sizing: border-box;
}

.item:last-child {
  margin-bottom: 0;
}

.name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.qty {
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

.price {
  width: 120rpx;
  text-align: right;
  color: #1a1a1a;
  font-weight: 500;
  flex-shrink: 0;
}

/* ========== 合计行 ========== */
.total-row {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
  min-height: 60rpx;
}

.total-price {
  color: #ea580c;
  font-size: 32rpx;
}

/* ========== 表单项 ========== */
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 80rpx;
  box-sizing: border-box;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  letter-spacing: 0.3rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.picker {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.input {
  text-align: right;
  font-size: 26rpx;
  flex: 1;
  margin-left: 16rpx;
  color: #1a1a1a;
}

/* ========== 底部固定栏 ========== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 100rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  align-items: center;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-top: 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.total {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.total-label {
  color: #666;
  font-weight: 500;
}

.total-value {
  color: #ea580c;
  font-size: 36rpx;
  font-weight: 700;
}

.submit-btn {
  width: 200rpx !important;
  min-height: 80rpx !important;
  margin: 0 !important;
  border-radius: 48rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  background: linear-gradient(135deg, #1a1a1a 0%, #333 100%) !important;
  letter-spacing: 1rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: 0 4rpx 12rpx rgba(26, 26, 26, 0.3) !important;
  flex-shrink: 0;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ========== 响应式适配 - 小屏幕设备 ========== */
@media screen and (max-width: 375px) {
  .confirm-container {
    padding: 16rpx;
  }

  .section {
    padding: 20rpx;
  }

  .section-title {
    font-size: 26rpx;
  }

  .item {
    font-size: 24rpx;
  }

  .qty {
    width: 60rpx;
  }

  .price {
    width: 100rpx;
  }

  .footer {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .total-value {
    font-size: 32rpx;
  }

  .submit-btn {
    width: 180rpx !important;
    font-size: 26rpx !important;
  }
}

/* ========== 响应式适配 - 大屏幕设备 ========== */
@media screen and (min-width: 414px) {
  .confirm-container {
    padding: 32rpx;
  }

  .section {
    padding: 32rpx;
  }

  .footer {
    padding-left: 32rpx;
    padding-right: 32rpx;
  }
}

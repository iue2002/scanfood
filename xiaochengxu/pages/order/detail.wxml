<!--pages/order/detail.wxml-->
<view class="detail-container">
  <!-- 状态卡片 -->
  <view class="status-card status-{{order.status}}">
    <view class="status-text">{{statusMap[order.status]}}</view>
    <view class="status-tips" wx:if="{{order.status === 'submitted' || order.status === 'printed'}}">厨师正在准备您的菜品，请稍候</view>
    <view class="status-tips" wx:if="{{order.status === 'settled'}}">感谢您的光临，欢迎下次再来</view>
  </view>

  <!-- 桌台信息 -->
  <view class="section">
    <view class="section-title">桌台信息</view>
    <view class="info-row">
      <text class="info-label">桌号</text>
      <text class="info-value">{{order.tables ? order.tables.table_number + '号桌' : '未知'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value order-no">{{order.order_number}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.created_at}}</text>
    </view>
  </view>

  <!-- 菜品明细 -->
  <view class="section">
    <view class="section-title">菜品明细</view>
    <view wx:for="{{order.order_items}}" wx:key="id" class="dish-item">
      <image class="dish-image" src="{{item.dish_image || '/images/default-dish.png'}}" mode="aspectFill"></image>
      <view class="dish-info">
        <view class="dish-name">{{item.dish_name}}</view>
        <view class="dish-spec" wx:if="{{item.spec_name}}">{{item.spec_name}}</view>
        <view class="dish-bottom">
          <view class="dish-qty">x{{item.quantity}}</view>
          <view class="dish-price">¥{{item.subtotal}}</view>
        </view>
      </view>
    </view>
    <view class="total-row">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{order.total_amount}}</text>
    </view>
  </view>

  <!-- 支付状态 -->
  <view class="section payment-section" wx:if="{{order.status !== 'settled'}}">
    <view class="payment-status">
      <text class="payment-icon">💰</text>
      <text class="payment-text">未付款，请餐后到前台结账</text>
    </view>
  </view>
  <view class="section payment-section" wx:if="{{order.status === 'settled'}}">
    <view class="payment-status settled">
      <text class="payment-icon">✅</text>
      <text class="payment-text">已结账</text>
      <text class="payment-time" wx:if="{{order.settled_at}}">（支付时间：{{order.settled_at}}）</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar" wx:if="{{order.status === 'submitted' || order.status === 'printed'}}">
    <button class="add-dish-btn" bindtap="goToOrder">继续加菜</button>
  </view>
</view>

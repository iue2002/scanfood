<!--pages/order/detail.wxml - 紧凑布局优化版-->
<view class="detail-container">
  <!-- 顶部状态栏：状态+桌台信息合并 -->
  <view class="status-card status-{{order.status}}">
    <view class="status-main">
      <view class="status-text">{{statusMap[order.status]}}</view>
      <view class="status-tips" wx:if="{{order.status === 'submitted' || order.status === 'printed'}}">未付款，请餐后到前台结账</view>
      <view class="status-tips" wx:if="{{order.status === 'settled'}}">已结账，感谢您的光临，欢迎下次再来</view>
    </view>
    <!-- 支付状态 -->
  
    <view class="status-info-row">
      <view class="status-info-item">
        <text class="info-label">桌号</text>
        <text class="info-value table-no">{{order.tables ? order.tables.table_number + '号桌' : '未知'}}</text>
      </view>
      
    </view>
  </view>

  <!-- 菜品明细 -->
  <view class="section">
    <view class="section-title">菜品明细</view>
    <view wx:if="{{order.groupedItems}}">
      <view wx:for="{{order.groupedItems}}" wx:key="round" class="item-group">
        <view class="group-label">{{item.label}}</view>
        <view wx:for="{{item.items}}" wx:key="id" wx:for-item="dish" class="dish-item">
          <image class="dish-image" src="{{dish.dish_image || '/images/default-dish.png'}}" mode="aspectFill"></image>
          <view class="dish-info">
            <view class="dish-name-row">
              <text class="dish-name">{{dish.dish_name}}</text>
              <text class="dish-spec" wx:if="{{dish.spec_name}}">{{dish.spec_name}}</text>
            </view>
            <view class="dish-meta">
              <view class="dish-adder" wx:if="{{dish.added_by_nickname}}">
                <text class="adder-tag">{{dish.added_by_nickname}} 添加</text>
              </view>
              <view class="dish-bottom">
                <view class="dish-qty">x{{dish.quantity}}</view>
                <view class="dish-price">¥{{dish.subtotal}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else>
      <view wx:for="{{order.order_items}}" wx:key="id" class="dish-item">
        <image class="dish-image" src="{{item.dish_image || '/images/default-dish.png'}}" mode="aspectFill"></image>
        <view class="dish-info">
          <view class="dish-name-row">
            <text class="dish-name">{{item.dish_name}}</text>
            <text class="dish-spec" wx:if="{{item.spec_name}}">{{item.spec_name}}</text>
          </view>
          <view class="dish-meta">
            <view class="dish-adder" wx:if="{{item.added_by_nickname}}">
              <text class="adder-tag">{{item.added_by_nickname}} 添加</text>
            </view>
            <view class="dish-bottom">
              <view class="dish-qty">x{{item.quantity}}</view>
              <view class="dish-price">¥{{item.subtotal}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="total-row">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{order.total_amount}}</text>
    </view>
  </view>

  <!-- 订单号：放在菜品下方 -->
  <view class="order-no-row">
    <view class="status-info-item">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.created_at}}</text>
      </view>
    <text class="order-no-label">订单号</text>
    <text class="order-no-value">{{order.order_number}}</text>
  </view>

  

  <!-- 操作按钮 -->
  <view class="action-bar" wx:if="{{order.status === 'submitted' || order.status === 'printed' || order.status === 'unpaid'}}">
    <button class="add-dish-btn" bindtap="goToOrder">继续加菜</button>
  </view>
</view>

<!-- 加餐弹窗 -->
<view class="add-more-modal" wx:if="{{showAddMoreModal}}" bindtap="closeAddMoreModal">
  <view class="modal-content" catchtap="preventClose">
    <view class="modal-header">
      <text class="title">添加菜品</text>
      <text class="close" bindtap="closeAddMoreModal">×</text>
    </view>

    <view class="modal-body">
      <!-- 左侧分类 -->
      <scroll-view class="category-list" scroll-y>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-item {{currentCategory === item.id ? 'active' : ''}}"
          bindtap="switchCategory"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </scroll-view>

      <!-- 右侧菜品 -->
      <scroll-view class="dish-list" scroll-y>
        <view wx:for="{{dishes}}" wx:key="id" class="modal-dish-item">
          <image class="modal-dish-image" src="{{item.image_url || '/images/default-dish.png'}}" mode="aspectFill"></image>
          <view class="modal-dish-info">
            <view class="modal-dish-name">{{item.name}}</view>
            <view class="modal-dish-desc" wx:if="{{item.description}}">{{item.description}}</view>
            <view class="modal-dish-price-row">
              <view class="modal-dish-price">¥{{item.price}}</view>
              <view class="modal-dish-action">
                <view class="minus" wx:if="{{addMoreCartCount[item.id] > 0}}" bindtap="updateAddMoreCart" data-id="{{item.id}}" data-type="minus">-</view>
                <view class="count" wx:if="{{addMoreCartCount[item.id] > 0}}" bindtap="onAddMoreCountTap" data-id="{{item.id}}" data-count="{{addMoreCartCount[item.id]}}">{{addMoreCartCount[item.id]}}</view>
                <view class="plus" bindtap="updateAddMoreCart" data-id="{{item.id}}" data-type="plus">+</view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="modal-footer">
      <view class="cart-info" wx:if="{{addMoreTotal > 0}}">
        <text class="cart-count">已选 {{cartItemCount}} 种菜品</text>
        <text class="cart-total">¥{{addMoreTotalStr}}</text>
      </view>
      <button class="submit-btn {{addMoreTotal > 0 ? 'active' : ''}}" bindtap="submitAddMore">{{addMoreTotal > 0 ? '提交加餐' : '请选择菜品'}}</button>
    </view>
  </view>
</view>

<!-- 加餐数量输入弹窗 -->
<view class="qty-modal" wx:if="{{showQtyModal}}" bindtap="closeQtyModal">
  <view class="qty-modal-content" catchtap="preventClose">
    <view class="qty-modal-header">
      <text class="qty-modal-title">输入数量</text>
      <text class="qty-modal-dish">{{editDishName}}</text>
    </view>
    <view class="qty-modal-body">
      <view class="qty-modal-ctrl">
        <view class="qty-modal-btn" bindtap="onQtyQuickSet" data-val="{{editDishCount - 1}}">−</view>
        <input class="qty-modal-input" type="number" value="{{editDishCount}}" bindinput="onQtyInput" focus="{{true}}" />
        <view class="qty-modal-btn" bindtap="onQtyQuickSet" data-val="{{editDishCount + 1}}">+</view>
      </view>
      <view class="qty-modal-quick">
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="5">5</view>
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="10">10</view>
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="15">15</view>
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="20">20</view>
        <view class="qty-quick-btn danger" bindtap="onQtyQuickSet" data-val="0">清空</view>
      </view>
    </view>
    <view class="qty-modal-footer">
      <button class="qty-modal-cancel" bindtap="closeQtyModal">取消</button>
      <button class="qty-modal-confirm" bindtap="confirmQty">确定</button>
    </view>
  </view>
</view>

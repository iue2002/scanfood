/* pages/order/detail.wxss */
.detail-container {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 24rpx;
}

/* 状态卡片 */
.status-card {
  padding: 32rpx 36rpx;
  text-align: center;
  margin-bottom: 16rpx;
  background: #fff;
}

.status-text {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.status-tips {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 0.3rpx;
}

/* 区块 */
.section {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 0.3rpx;
}

.info-value {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.order-no {
  font-family: monospace;
  font-size: 24rpx;
}

/* 菜品列表 */
.dish-item {
  display: flex;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-name {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.3rpx;
}

.dish-spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.dish-adder {
  margin-top: 4rpx;
}

.adder-tag {
  font-size: 20rpx;
  color: #ff6b35;
  background: #fff5f0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.dish-qty {
  font-size: 24rpx;
  color: #999;
}

.dish-price {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
}

.total-label {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.total-price {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

/* 支付状态 */
.payment-section {
  padding: 0;
}

.payment-status {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fafafa;
}

.payment-status.settled {
  background: #fafafa;
}

.payment-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.payment-text {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.payment-status.settled .payment-text {
  color: #1a1a1a;
}

.payment-time {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 操作按钮 */
.action-bar {
  padding: 0 24rpx;
}

.add-dish-btn {
  width: 100%;
  background: #1a1a1a;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 加餐弹窗 */
.add-more-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90%;
  height: 85vh;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}

.modal-header .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-header .close {
  font-size: 40rpx;
  color: #999;
  padding: 0 8rpx;
  line-height: 1;
}

.modal-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-list {
  width: 200rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.category-item {
  padding: 24rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-left: 4rpx solid transparent;
}

.category-item.active {
  background: #fff;
  color: #1a1a1a;
  font-weight: 600;
  border-left-color: #1a1a1a;
}

.dish-list {
  flex: 1;
  padding: 16rpx;
}

.modal-dish-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-dish-item:last-child {
  border-bottom: none;
}

.modal-dish-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.modal-dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.modal-dish-name {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-dish-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-dish-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.modal-dish-price {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.modal-dish-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-dish-action .minus,
.modal-dish-action .plus {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-dish-action .minus {
  border: 2rpx solid #ddd;
  color: #666;
}

.modal-dish-action .plus {
  background: #1a1a1a;
  color: #fff;
}

.modal-dish-action .count {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  min-width: 36rpx;
  text-align: center;
}

.modal-footer {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.cart-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cart-count {
  font-size: 24rpx;
  color: #999;
}

.cart-total {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.submit-btn {
  width: 100%;
  background: #ccc;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.submit-btn.active {
  background: #1a1a1a;
}

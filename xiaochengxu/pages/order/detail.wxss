/* pages/order/detail.wxss - 紧凑布局优化版 */

/* ========== 基础容器 ========== */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #1a1a1a;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  box-sizing: border-box;
}

.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
  padding-bottom: constant(safe-area-inset-bottom);
}

/* ========== 状态卡片 - 紧凑合并版 ========== */
.status-card {
  padding: 24rpx;
  text-align: center;
  margin-bottom: 12rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.status-main {
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.status-tips {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 0.3rpx;
}

.status-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.status-info-item {
  display: flex;
  align-items: center;
  flex: 1;
}

.status-info-item:first-child {
  margin-right: 16rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.table-no {
  color: #2563eb;
  font-weight: 600;
  font-size: 28rpx;
}

/* ========== 通用区块 - 紧凑边距 ========== */
.section {
  background: #fff;
  margin: 0 16rpx 12rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

/* ========== 菜品分组 ========== */
.item-group {
  margin-bottom: 0;
}

.group-label {
  font-size: 22rpx;
  color: #2563eb;
  padding: 10rpx 20rpx;
  background: #f0f6ff;
  border-left: 4rpx solid #2563eb;
  font-weight: 600;
}

/* ========== 菜品列表 - 紧凑版 ========== */
.dish-item {
  display: flex;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
  align-items: flex-start;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  overflow: hidden;
}

.dish-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.dish-name {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.3rpx;
  max-width: 100%;
}

.dish-spec {
  font-size: 20rpx;
  color: #999;
  flex-shrink: 0;
}

.dish-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.dish-adder {
  display: flex;
  align-items: center;
}

.adder-tag {
  font-size: 18rpx;
  color: #ff6b35;
  background: #fff5f0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  display: inline-block;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-bottom {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.dish-qty {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.dish-price {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ========== 合计行 - 紧凑版 ========== */
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
  min-height: 72rpx;
}

.total-label {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
}

.total-price {
  font-size: 34rpx;
  color: #ea580c;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
}

/* ========== 订单号行 ========== */
.order-no-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  margin: 0 16rpx 12rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-no-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.order-no-value {
  font-size: 22rpx;
  color: #666;
  font-family: Consolas, Monaco, 'Courier New', monospace;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 500rpx;
  text-align: right;
}

/* ========== 支付状态 - 紧凑版 ========== */
.payment-section {
  margin: 0 16rpx 12rpx;
}

.payment-status {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  flex-wrap: wrap;
  gap: 8rpx;
}

.payment-status.settled {
  background: #fff;
}

.payment-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.payment-text {
  font-size: 24rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex: 1;
  white-space: normal;
  word-break: break-all;
}

.payment-status.settled .payment-text {
  color: #10b981;
}

.payment-time {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* ========== 操作按钮 - 紧凑版 ========== */
.action-bar {
  padding: 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
}

.add-dish-btn {
  width: 100%;
  background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(26, 26, 26, 0.3);
}

.add-dish-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ========== 加餐弹窗 - 紧凑版 ========== */
.add-more-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(2rpx);
}

.modal-content {
  width: 94%;
  max-width: 720rpx;
  height: 85vh;
  max-height: 1000rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
}

.modal-header {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  min-height: 80rpx;
  box-sizing: border-box;
}

.modal-header .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-header .close {
  font-size: 40rpx;
  color: #999;
  padding: 6rpx;
  line-height: 1;
  min-width: 44rpx;
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}

/* 分类列表 */
.category-list {
  width: 160rpx;
  background: #f8f8f8;
  flex-shrink: 0;
  height: 100%;
}

.category-item {
  padding: 24rpx 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  border-left: 4rpx solid transparent;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-item.active {
  background: #fff;
  color: #1a1a1a;
  font-weight: 600;
  border-left-color: #1a1a1a;
}

/* 菜品列表 */
.dish-list {
  flex: 1;
  padding: 12rpx;
  height: 100%;
}

.modal-dish-item {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  align-items: center;
  box-sizing: border-box;
  min-height: 100rpx;
}

.modal-dish-item:last-child {
  border-bottom: none;
}

.modal-dish-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.modal-dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  height: 88rpx;
  overflow: hidden;
}

.modal-dish-name {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-dish-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-dish-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6rpx;
}

.modal-dish-price {
  font-size: 26rpx;
  color: #ea580c;
  font-weight: 700;
  flex-shrink: 0;
}

.modal-dish-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.modal-dish-action .minus,
.modal-dish-action .plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  min-width: 48rpx;
  min-height: 48rpx;
}

.modal-dish-action .minus {
  border: 2rpx solid #ddd;
  color: #666;
  background: #fff;
}

.modal-dish-action .plus {
  background: #1a1a1a;
  color: #fff;
}

.modal-dish-action .count {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 600;
  min-width: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 弹窗底部 */
.modal-footer {
  padding: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
  min-height: 100rpx;
  box-sizing: border-box;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  background: #fff;
}

.cart-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.cart-count {
  font-size: 22rpx;
  color: #666;
  flex-shrink: 0;
}

.cart-total {
  font-size: 28rpx;
  color: #ea580c;
  font-weight: 700;
  flex-shrink: 0;
}

.submit-btn {
  width: 100%;
  background: #ccc;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.active {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.submit-btn.active:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ========== 响应式适配 - 小屏幕设备 ========== */
@media screen and (max-width: 375px) {
  .status-card {
    padding: 20rpx;
  }

  .status-text {
    font-size: 30rpx;
  }

  .section {
    margin: 0 12rpx 10rpx;
  }

  .dish-item {
    padding: 12rpx 16rpx;
  }

  .dish-image {
    width: 72rpx;
    height: 72rpx;
    margin-right: 12rpx;
  }

  .total-price {
    font-size: 30rpx;
  }

  .modal-content {
    width: 96%;
  }

  .category-list {
    width: 140rpx;
  }

  .modal-dish-image {
    width: 80rpx;
    height: 80rpx;
  }
}

/* ========== 响应式适配 - 大屏幕设备 ========== */
@media screen and (min-width: 414px) {
  .modal-content {
    width: 90%;
  }

  .modal-dish-image {
    width: 96rpx;
    height: 96rpx;
  }
}

/* pages/order/detail.wxss */
.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 状态卡片 */
.status-card {
  padding: 20rpx 30rpx;
  text-align: center;
  margin-bottom: 12rpx;
}

.status-card.status-draft {
  background: #f0f0f0;
}

.status-card.status-submitted,
.status-card.status-printed {
  background: #fff3e0;
}

.status-card.status-settled {
  background: #e8f5e9;
}

.status-card.status-cancelled {
  background: #ffebee;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.status-tips {
  font-size: 22rpx;
  color: #666;
}

/* 区块 */
.section {
  background: #fff;
  margin: 0 20rpx 12rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  color: #333;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 24rpx;
  color: #666;
}

.info-value {
  font-size: 24rpx;
  color: #333;
}

.order-no {
  font-family: monospace;
  font-size: 22rpx;
}

/* 菜品列表 */
.dish-item {
  display: flex;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-spec {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6rpx;
}

.dish-qty {
  font-size: 22rpx;
  color: #999;
}

.dish-price {
  font-size: 26rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fafafa;
  border-top: 1rpx dashed #eee;
}

.total-label {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.total-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

/* 支付状态 */
.payment-section {
  padding: 0;
}

.payment-status {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff8e1;
}

.payment-status.settled {
  background: #e8f5e9;
}

.payment-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.payment-text {
  font-size: 24rpx;
  color: #ff9d00;
  font-weight: 500;
}

.payment-status.settled .payment-text {
  color: #4caf50;
}

.payment-time {
  font-size: 20rpx;
  color: #999;
  margin-left: 6rpx;
}

/* 操作按钮 */
.action-bar {
  padding: 0 20rpx;
}

.add-dish-btn {
  width: 100%;
  background: #ff9d00;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: bold;
}

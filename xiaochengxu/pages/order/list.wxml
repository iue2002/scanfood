<!--pages/order/list.wxml-->
<view class="list-container">
  <!-- 订单状态标签 -->
  <view class="tabs">
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text class="tab-text">全部</text>
      <view class="tab-line" wx:if="{{currentTab === 'all'}}"></view>
    </view>
    <view class="tab-item {{currentTab === 'draft' ? 'active' : ''}}" bindtap="switchTab" data-tab="draft">
      <text class="tab-text">待提交</text>
      <view class="tab-line" wx:if="{{currentTab === 'draft'}}"></view>
    </view>
    <view class="tab-item {{currentTab === 'submitted' ? 'active' : ''}}" bindtap="switchTab" data-tab="submitted">
      <text class="tab-text">已提交</text>
      <view class="tab-line" wx:if="{{currentTab === 'submitted'}}"></view>
    </view>
    <view class="tab-item {{currentTab === 'settled' ? 'active' : ''}}" bindtap="switchTab" data-tab="settled">
      <text class="tab-text">已结账</text>
      <view class="tab-line" wx:if="{{currentTab === 'settled'}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-section">
    <view class="empty" wx:if="{{filteredOrders.length === 0 && !isLoading}}">
      <view class="empty-icon">📋</view>
      <view class="empty-text">暂无订单</view>
      <view class="empty-desc">快去扫码点餐吧~</view>
    </view>

    <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="id">
        <!-- 订单头部：店铺名 + 状态 -->
        <view class="order-header">
          <view class="shop-info" bindtap="goToDetail" data-id="{{item.id}}">
            <image wx:if="{{storeAvatar}}" class="shop-avatar" src="{{storeAvatar}}" mode="aspectFill"></image>
            <view wx:else class="shop-icon">🐰</view>
            <view class="shop-name">{{storeName || '伊美轩'}}</view>
            <view class="arrow-icon">›</view>
          </view>
          <view class="order-status status-{{item.status}}">{{item.status === 'settled' ? '已完成' : statusMap[item.status]}}</view>
        </view>

        <!-- 订单主体：菜品列表 + 价格 -->
        <view class="order-body" bindtap="goToDetail" data-id="{{item.id}}">
          <view class="items-row">
            <view class="item-cell" wx:for="{{item.itemImages}}" wx:for-item="img" wx:for-index="idx" wx:key="idx">
              <image class="item-image" src="{{img || '/images/default-dish.png'}}" mode="aspectFill"></image>
              <view class="item-name">{{item.itemNames[idx]}}</view>
              <view class="item-qty">×{{item.itemQtys[idx]}}</view>
            </view>
          </view>
          <view class="price-column">
            <view class="total-price">¥{{item.total_amount}}</view>
            <view class="total-count">共{{item.totalItems}}件</view>
          </view>
        </view>

        <!-- 底部：时间 + 操作 -->
        <view class="order-footer">
          <view class="order-time">
            <text class="time-label">下单：</text>
            <text class="time-value">{{item.created_at}}</text>
          </view>
          <view class="footer-actions">
            <view class="more-btn" bindtap="goToDetail" data-id="{{item.id}}">更多</view>
            <view class="reorder-btn" catchtap="reorder" data-id="{{item.id}}" wx:if="{{item.status === 'settled'}}">再来一单</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>
</view>

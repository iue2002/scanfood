<!--pages/order/list.wxml-->
<view class="list-container">
  <!-- 订单状态标签 -->
  <view class="tabs">
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text class="tab-text">全部</text>
      <view class="tab-line" wx:if="{{currentTab === 'all'}}"></view>
    </view>
    <view class="tab-item {{currentTab === 'draft' ? 'active' : ''}}" bindtap="switchTab" data-tab="draft">
      <text class="tab-text">待提交</text>
      <view class="tab-line" wx:if="{{currentTab === 'draft'}}"></view>
    </view>
    <view class="tab-item {{currentTab === 'submitted' ? 'active' : ''}}" bindtap="switchTab" data-tab="submitted">
      <text class="tab-text">已提交</text>
      <view class="tab-line" wx:if="{{currentTab === 'submitted'}}"></view>
    </view>
    <view class="tab-item {{currentTab === 'settled' ? 'active' : ''}}" bindtap="switchTab" data-tab="settled">
      <text class="tab-text">已结账</text>
      <view class="tab-line" wx:if="{{currentTab === 'settled'}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-section">
    <view class="empty" wx:if="{{filteredOrders.length === 0 && !isLoading}}">
      <view class="empty-icon">📋</view>
      <view class="empty-text">暂无订单</view>
      <view class="empty-desc">快去扫码点餐吧~</view>
    </view>

    <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <!-- 订单头部 -->
        <view class="order-header">
          <view class="order-info-left">
            <view class="order-time">{{item.created_at}}</view>
            <view class="order-table" wx:if="{{item.tables}}">
              <text class="table-icon">📍</text>
              <text class="table-text">{{item.tables.table_number}}号桌</text>
            </view>
          </view>
          <view class="order-status status-{{item.status}}">{{statusMap[item.status]}}</view>
        </view>

        <!-- 订单内容 -->
        <view class="order-content">
          <view class="order-items">
            <view class="order-item-row" wx:for="{{item.order_items}}" wx:for-item="orderItem" wx:key="id" wx:if="{{index < 3}}">
              <view class="item-name">{{orderItem.dish_name}}</view>
              <view class="item-quantity">x{{orderItem.quantity}}</view>
            </view>
            <view class="more-items" wx:if="{{item.order_items.length > 3}}">
              <text>...等{{item.order_items.length}}件商品</text>
            </view>
          </view>
          <view class="order-total">
            <view class="total-label">合计</view>
            <view class="total-amount">¥{{item.total_amount}}</view>
          </view>
        </view>

        <!-- 未付款提示 -->
        <view class="payment-tip" wx:if="{{item.status === 'submitted' || item.status === 'printed'}}">
          <text class="tip-icon">💰</text>
          <text class="tip-text">未付款，请餐后到前台结账</text>
        </view>

        <!-- 订单底部操作 -->
        <view class="order-footer">
          <view class="order-actions">
            <view class="action-btn primary" catchtap="goToDetail" data-id="{{item.id}}">查看详情</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>
</view>

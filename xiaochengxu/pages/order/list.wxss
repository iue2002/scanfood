/* pages/order/list.wxss */
.list-container {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 24rpx;
}

/* 标签栏 */
.tabs {
  background: #fff;
  margin: 0 0 16rpx;
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
}

.tab-text {
  font-size: 28rpx;
  color: #999;
  transition: all 0.3s;
  letter-spacing: 0.3rpx;
}

.tab-item.active .tab-text {
  color: #1a1a1a;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 5rpx;
  background: #1a1a1a;
  border-radius: 3rpx;
}

/* 订单列表 */
.order-section {
  padding: 0 24rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-info-left {
  flex: 1;
}

.order-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.order-table {
  display: flex;
  align-items: center;
}

.table-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.table-text {
  font-size: 24rpx;
  color: #666;
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
  background: #f5f5f5;
  color: #666;
  letter-spacing: 0.3rpx;
}

.status-draft {
  background: #f0f0f0;
  color: #666;
}

.status-submitted {
  background: #f5f5f5;
  color: #1a1a1a;
}

.status-printed {
  background: #f5f5f5;
  color: #1a1a1a;
}

.status-settled {
  background: #f5f5f5;
  color: #1a1a1a;
}

.status-cancelled {
  background: #f5f5f5;
  color: #999;
}

.status-refunded {
  background: #f5f5f5;
  color: #999;
}

/* 订单内容 */
.order-content {
  padding: 24rpx;
}

.order-items {
  margin-bottom: 16rpx;
}

.order-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.item-name {
  font-size: 28rpx;
  color: #1a1a1a;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.3rpx;
}

.item-quantity {
  font-size: 26rpx;
  color: #999;
  margin-left: 20rpx;
}

.more-items {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}

.order-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-amount {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

/* 未付款提示 */
.payment-tip {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #666;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
}

.order-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: 1rpx solid #e0e0e0;
  color: #666;
  background: #fff;
  letter-spacing: 0.3rpx;
}

.action-btn.primary {
  background: #1a1a1a;
  color: #fff;
  border-color: #1a1a1a;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.2;
}

.empty-text {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* pages/order/list.wxss */
.list-container {
  min-height: 100vh;
  background: var(--bg-slate);
  padding-bottom: 24rpx;
}

/* 标签栏 */
.tabs {
  background: #fff;
  margin: 0 0 12rpx;
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-muted);
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: var(--primary);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 4rpx;
}

/* 订单列表 */
.order-section {
  padding: 0 16rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-card {
  background: #fff;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
}

.shop-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.shop-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.shop-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #f5f5f5;
}

.shop-name {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-icon {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-left: 6rpx;
  flex-shrink: 0;
}

.order-status {
  font-size: 20rpx;
  color: var(--success);
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.status-submitted,
.status-printed {
  color: #f59e0b;
}

.status-cancelled,
.status-refunded {
  color: #999;
}

/* 订单主体：图片 + 价格 */
.order-body {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  gap: 20rpx;
}

.items-row {
  display: flex;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.item-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.item-image {
  width: 130rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
}

.item-name {
  font-size: 22rpx;
  color: #666;
  max-width: 130rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  margin-top: 6rpx;
}

.item-qty {
  font-size: 20rpx;
  color: #ea580c;
  font-weight: 600;
  margin-top: 2rpx;
}

.price-column {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.total-price {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.total-count {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

/* 底部：时间 + 操作 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 22rpx;
  color: #bbb;
}

.time-label {
  color: #bbb;
}

.time-value {
  color: #bbb;
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.more-btn {
  font-size: 22rpx;
  color: #bbb;
}

.reorder-btn {
  font-size: 24rpx;
  color: #ea580c;
  border: 1rpx solid #ea580c;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  font-weight: 500;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.2;
}

.empty-text {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

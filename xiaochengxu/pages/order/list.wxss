/* pages/order/list.wxss */
.list-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 24rpx;
}

/* 标签栏 */
.tabs {
  background: #fff;
  margin: 0 0 16rpx;
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
}

.tab-text {
  font-size: 28rpx;
  color: #999;
  transition: all 0.3s;
  letter-spacing: 0.3rpx;
}

.tab-item.active .tab-text {
  color: #1a1a1a;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 5rpx;
  background: #1a1a1a;
  border-radius: 3rpx;
}

/* 订单列表 */
.order-section {
  padding: 0 24rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.shop-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.shop-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.shop-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #f5f5f5;
}

.shop-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  flex: 1;
  letter-spacing: 0.3rpx;
}

.arrow-icon {
  font-size: 32rpx;
  color: #999;
  margin-left: 8rpx;
}

.order-status {
  font-size: 22rpx;
  color: #10b981;
  font-weight: 500;
}

.status-submitted,
.status-printed {
  color: #f59e0b;
}

.status-cancelled,
.status-refunded {
  color: #999;
}

/* 订单内容 */
.order-content {
  padding: 0 24rpx 20rpx;
}

.item-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.item-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.item-names {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 26rpx;
  color: #666;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.total-price {
  font-size: 36rpx;
  color: #1a1a1a;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.total-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 下单时间 */
.order-time-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.time-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.time-value {
  font-size: 24rpx;
  color: #999;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.more-btn {
  font-size: 24rpx;
  color: #999;
}

.reorder-btn {
  font-size: 26rpx;
  color: #ea580c;
  border: 2rpx solid #ea580c;
  border-radius: 36rpx;
  padding: 12rpx 32rpx;
  font-weight: 500;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.2;
}

.empty-text {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
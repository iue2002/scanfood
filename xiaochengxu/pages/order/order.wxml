<!--pages/order/order.wxml — 商家端主题对齐版（仅视觉重构，业务字段保持原状）-->
<view class="om-page">
  <!-- 状态栏占位（custom navigationStyle 必需，避开手机顶部时间/电量区） -->
  <view class="om-status-bar" style="height: {{statusBarHeight || 20}}px;"></view>

  <!-- 自定义品牌导航栏（避开微信胶囊按钮的 175rpx 区域） -->
  <view class="om-brand-bar">
    <block wx:if="{{storeInfo && storeInfo.store_avatar}}">
      <image class="om-brand-avatar" src="{{storeInfo.store_avatar}}" mode="aspectFill" />
    </block>
    <block wx:else>
      <view class="om-brand-avatar om-brand-avatar-placeholder">
        <text>{{storeInfo && storeInfo.store_name ? storeInfo.store_name.charAt(0) : '店'}}</text>
      </view>
    </block>
    <text class="om-brand-name">{{storeInfo.store_name || '我的小店'}}</text>
  </view>

  <!-- 顶部桌号 / 扫码栏 -->
  <view class="om-topbar">
    <view class="om-topbar-left">
      <block wx:if="{{tableNumber}}">
        <text class="om-table-num">{{tableNumber}}</text>
        <text class="om-table-suffix">桌</text>
        <view class="om-rescan-inline" bindtap="startScan" hover-class="om-rescan-inline-hover">
          <text>重扫</text>
        </view>
      </block>
      <view class="om-scan-hint" wx:else bindtap="startScan">
        <view class="om-scan-icon">
          <view class="om-scan-icon-line"></view>
          <view class="om-scan-icon-line om-scan-icon-line-mid"></view>
          <view class="om-scan-icon-line"></view>
        </view>
        <text class="om-scan-hint-text">请先扫码</text>
        <text class="om-scan-hint-arrow">›</text>
      </view>
    </view>
    <view class="om-takeaway-btn {{isTakeaway ? 'om-takeaway-btn-active' : ''}}" bindtap="goTakeaway" hover-class="om-takeaway-btn-hover">
      <text class="om-takeaway-icon">🛍</text>
      <text class="om-takeaway-text">{{isTakeaway ? '外带中' : '打包带走'}}</text>
    </view>
  </view>

  <!-- 主体：左分类 + 右菜品 -->
  <view class="om-main">
    <!-- 左侧分类 -->
    <scroll-view class="om-cat" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="om-cat-item {{currentCategory === item.id ? 'om-cat-item-active' : ''}}"
        bindtap="switchCategory"
        data-id="{{item.id}}"
      >
        <text class="om-cat-text">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view class="om-dish" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="om-dish-cat-title">{{currentCategoryName}}</view>

      <view wx:for="{{dishes}}" wx:key="id" class="om-dish-card">
        <image
          class="om-dish-img"
          src="{{item.image_url || '/images/default-dish.png'}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="om-dish-info">
          <view class="om-dish-name-row">
            <text class="om-dish-name">{{item.name}}</text>
          </view>
          <text class="om-dish-desc" wx:if="{{item.description}}">{{item.description}}</text>
          <view class="om-dish-bottom">
            <view class="om-price-wrap">
              <text class="om-price-symbol">¥</text>
              <text class="om-price-num">{{item.price}}</text>
            </view>
            <view class="om-step">
              <view
                class="om-step-minus"
                wx:if="{{cartCount[item.id] > 0}}"
                bindtap="updateCart"
                data-id="{{item.id}}"
                data-type="minus"
                hover-class="om-step-minus-hover"
              >−</view>
              <view
                class="om-step-count"
                wx:if="{{cartCount[item.id] > 0}}"
                bindtap="onCountTap"
                data-id="{{item.id}}"
                data-count="{{cartCount[item.id]}}"
              >{{cartCount[item.id]}}</view>
              <view
                class="om-step-plus"
                bindtap="updateCart"
                data-id="{{item.id}}"
                data-type="plus"
                hover-class="om-step-plus-hover"
              >+</view>
            </view>
          </view>
        </view>
      </view>

      <view class="om-bottom-spacer"></view>
    </scroll-view>
  </view>

  <!-- 悬浮购物车栏 -->
  <view class="om-cart-bar" wx:if="{{totalCount > 0}}">
    <view class="om-cart-bar-info" bindtap="goToCart">
      <view class="om-cart-bar-icon">
        <view class="om-icon-cart-mini">
          <view class="om-icon-cart-mini-handle"></view>
          <view class="om-icon-cart-mini-body"></view>
          <view class="om-icon-cart-mini-wheel"></view>
          <view class="om-icon-cart-mini-wheel om-icon-cart-mini-wheel-2"></view>
        </view>
        <view class="om-cart-bar-badge">{{totalCount}}</view>
      </view>
      <view class="om-cart-bar-amount">
        <text class="om-cart-bar-symbol">¥</text>
        <text class="om-cart-bar-num">{{totalPrice}}</text>
      </view>
    </view>
    <view class="om-cart-bar-submit" bindtap="goToConfirm" hover-class="om-cart-bar-submit-hover">
      {{isTakeaway ? '提交外带' : (isAddMore ? '提交加餐' : '去结算')}}
    </view>
  </view>
</view>

<!-- 数量输入弹窗 -->
<view class="om-qty-modal" wx:if="{{showQtyModal}}" bindtap="closeQtyModal">
  <view class="om-qty-card" catchtap="preventClose">
    <view class="om-qty-head">
      <text class="om-qty-title">输入数量</text>
      <text class="om-qty-dish">{{editDishName}}</text>
    </view>
    <view class="om-qty-body">
      <view class="om-qty-ctrl">
        <view class="om-qty-btn" bindtap="onQtyQuickSet" data-val="{{editDishCount - 1}}">−</view>
        <input class="om-qty-input" type="number" value="{{editDishCount}}" bindinput="onQtyInput" focus="{{true}}" />
        <view class="om-qty-btn" bindtap="onQtyQuickSet" data-val="{{editDishCount + 1}}">+</view>
      </view>
      <view class="om-qty-quick">
        <view class="om-qty-quick-btn" bindtap="onQtyQuickSet" data-val="5">5</view>
        <view class="om-qty-quick-btn" bindtap="onQtyQuickSet" data-val="10">10</view>
        <view class="om-qty-quick-btn" bindtap="onQtyQuickSet" data-val="15">15</view>
        <view class="om-qty-quick-btn" bindtap="onQtyQuickSet" data-val="20">20</view>
        <view class="om-qty-quick-btn om-qty-quick-btn-danger" bindtap="onQtyQuickSet" data-val="0">清空</view>
      </view>
    </view>
    <view class="om-qty-foot">
      <button class="om-qty-cancel" bindtap="closeQtyModal">取消</button>
      <button class="om-qty-confirm" bindtap="confirmQty">确定</button>
    </view>
  </view>
</view>


<!-- 购物车弹窗（替代 pages/order/cart 跳转）-->
<view class="om-cart-modal" wx:if="{{showCartPanel}}" bindtap="closeCartPanel">
  <view class="om-cart-sheet" catchtap="preventClose">
    <!-- 顶部 -->
    <view class="om-cart-head">
      <view class="om-cart-head-left">
        <text class="om-cart-head-title">购物车</text>
        <text class="om-cart-head-meta" wx:if="{{tableNumber}}">{{tableNumber}}号桌</text>
      </view>
      <view class="om-cart-head-actions">
        <view
          class="om-cart-clear"
          wx:if="{{cartItems.length > 0}}"
          bindtap="clearCart"
          hover-class="om-cart-clear-hover"
        >清空</view>
        <view class="om-cart-close" bindtap="closeCartPanel" hover-class="om-cart-close-hover">✕</view>
      </view>
    </view>

    <!-- 列表 -->
    <scroll-view class="om-cart-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="om-cart-empty" wx:if="{{cartItems.length === 0}}">
        <text class="om-cart-empty-text">购物车是空的</text>
        <text class="om-cart-empty-desc">快去选择喜欢的菜品吧</text>
      </view>

      <view class="om-cart-row" wx:for="{{cartItems}}" wx:key="id">
        <image class="om-cart-row-img" src="{{item.image_url || '/images/default-dish.png'}}" mode="aspectFill" />
        <view class="om-cart-row-info">
          <text class="om-cart-row-name">{{item.dish_name}}</text>
          <view class="om-cart-row-price-row">
            <text class="om-cart-row-price-symbol">¥</text>
            <text class="om-cart-row-price-num">{{item.price}}</text>
          </view>
          <view class="om-cart-row-bottom">
            <text class="om-cart-row-subtotal">¥{{item.subtotal}}</text>
            <view class="om-step">
              <view
                class="om-step-minus"
                bindtap="updateCart"
                data-id="{{item.id}}"
                data-type="minus"
                hover-class="om-step-minus-hover"
              >−</view>
              <view class="om-step-count" bindtap="onCountTap" data-id="{{item.id}}" data-count="{{item.quantity}}">{{item.quantity}}</view>
              <view
                class="om-step-plus"
                bindtap="updateCart"
                data-id="{{item.id}}"
                data-type="plus"
                hover-class="om-step-plus-hover"
              >+</view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部结算 -->
    <view class="om-cart-foot" wx:if="{{cartItems.length > 0}}">
      <view class="om-cart-foot-info">
        <text class="om-cart-foot-count">共 {{totalCount}} 件</text>
        <view class="om-cart-foot-amount">
          <text class="om-cart-foot-symbol">¥</text>
          <text class="om-cart-foot-num">{{totalPrice}}</text>
        </view>
      </view>
      <view
        class="om-cart-foot-submit"
        bindtap="goToConfirm"
        hover-class="om-cart-foot-submit-hover"
      >{{isTakeaway ? '提交外带' : (isAddMore ? '提交加餐' : '去下单')}}</view>
    </view>
  </view>
</view>


<!-- 全局主题 modal（替代 wx.showModal） -->
<theme-modal id="themeModal" />


<!--pages/order/order.wxml-->
<view class="order-container">
  <!-- 顶部桌号 -->
  <view class="header-bar">
    <view class="table-info">
      <block wx:if="{{tableNumber}}">
        <text class="table-num">{{tableNumber}}</text>
        <text class="table-label">号桌</text>
      </block>
      <block wx:else>
        <view class="scan-hint" bindtap="startScan">
          <text class="scan-hint-text">请先扫码</text>
          <text class="scan-hint-arrow">›</text>
        </view>
      </block>
    </view>
    <view class="scan-entry" bindtap="startScan">
      <view class="scan-icon">
        <view class="scan-line scan-line-1"></view>
        <view class="scan-line scan-line-2"></view>
        <view class="scan-line scan-line-3"></view>
      </view>
      <text>重扫</text>
    </view>
  </view>

  <view class="main-content">
    <!-- 左侧分类 -->
    <scroll-view class="category-list" scroll-y>
      <view 
        wx:for="{{categories}}" 
        wx:key="id" 
        class="category-item {{currentCategory === item.id ? 'active' : ''}}"
        bindtap="switchCategory"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 右侧菜品 -->
    <scroll-view class="dish-list" scroll-y>
      <view wx:for="{{dishes}}" wx:key="id" class="dish-item">
        <image class="dish-image" src="{{item.image_url || '/images/default-dish.png'}}" mode="aspectFill" lazy-load></image>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-desc" wx:if="{{item.description}}">{{item.description}}</view>
          <view class="dish-price-row">
            <view class="dish-price">￥{{item.price}}</view>
            <view class="dish-action">
              <view class="minus" wx:if="{{cartCount[item.id] > 0}}" bindtap="updateCart" data-id="{{item.id}}" data-type="minus">-</view>
              <view class="count" wx:if="{{cartCount[item.id] > 0}}" bindtap="onCountTap" data-id="{{item.id}}" data-count="{{cartCount[item.id]}}">{{cartCount[item.id]}}</view>
              <view class="plus" bindtap="updateCart" data-id="{{item.id}}" data-type="plus">+</view>
            </view>
          </view>
        </view>
      </view>
      <view class="bottom-placeholder"></view>
    </scroll-view>
  </view>

  <!-- 购物车栏 (悬浮) -->
  <view class="cart-bar" wx:if="{{totalCount > 0}}">
    <view class="cart-info" bindtap="goToCart">
      <view class="cart-icon">🛒</view>
      <view class="badge">{{totalCount}}</view>
      <view class="total-price">￥{{totalPrice}}</view>
    </view>
    <view class="submit-btn" bindtap="goToConfirm">{{isAddMore ? '提交加餐' : '下单'}}</view>
  </view>
</view>

<!-- 数量输入弹窗 -->
<view class="qty-modal" wx:if="{{showQtyModal}}" bindtap="closeQtyModal">
  <view class="qty-modal-content" catchtap="preventClose">
    <view class="qty-modal-header">
      <text class="qty-modal-title">输入数量</text>
      <text class="qty-modal-dish">{{editDishName}}</text>
    </view>
    <view class="qty-modal-body">
      <view class="qty-modal-ctrl">
        <view class="qty-modal-btn" bindtap="onQtyQuickSet" data-val="{{editDishCount - 1}}">−</view>
        <input class="qty-modal-input" type="number" value="{{editDishCount}}" bindinput="onQtyInput" focus="{{true}}" />
        <view class="qty-modal-btn" bindtap="onQtyQuickSet" data-val="{{editDishCount + 1}}">+</view>
      </view>
      <view class="qty-modal-quick">
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="5">5</view>
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="10">10</view>
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="15">15</view>
        <view class="qty-quick-btn" bindtap="onQtyQuickSet" data-val="20">20</view>
        <view class="qty-quick-btn danger" bindtap="onQtyQuickSet" data-val="0">清空</view>
      </view>
    </view>
    <view class="qty-modal-footer">
      <button class="qty-modal-cancel" bindtap="closeQtyModal">取消</button>
      <button class="qty-modal-confirm" bindtap="confirmQty">确定</button>
    </view>
  </view>
</view>

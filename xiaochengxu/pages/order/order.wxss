/* pages/order/order.wxss */
.order-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  background: var(--bg-slate);
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 未扫码提示（桌号位置内联） */
.scan-hint {
  display: flex;
  align-items: center;
  cursor: pointer;
}

.scan-hint-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
  letter-spacing: 0.5rpx;
}

.scan-hint-arrow {
  font-size: 36rpx;
  color: var(--primary);
  margin-left: 8rpx;
}

/* 顶部桌号栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  flex-shrink: 0;
  border-bottom: 2rpx solid var(--border-color);
}

.table-info {
  display: flex;
  align-items: baseline;
}

.table-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 8rpx;
  letter-spacing: 1rpx;
}

.table-label {
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 0.3rpx;
}

.scan-entry {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  letter-spacing: 0.3rpx;
}

.scan-icon {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  margin-right: 8rpx;
  width: 24rpx;
  height: 24rpx;
}

.scan-line {
  width: 20rpx;
  height: 3rpx;
  background: #666;
  border-radius: 2rpx;
}

.scan-line-1 {
  width: 14rpx;
}

.scan-line-3 {
  width: 10rpx;
}

/* 主体内容区 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-list {
  width: 150rpx;
  background: #fff;
  height: 100%;
  border-right: 2rpx solid var(--border-color);
}

.category-item {
  padding: 36rpx 12rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
  border-left: 6rpx solid transparent;
  letter-spacing: 0.3rpx;
}

.category-item.active {
  color: var(--primary);
  font-weight: 600;
  background: var(--primary-light);
  border-left-color: var(--primary);
}

.dish-list {
  flex: 1;
  padding: 20rpx;
  background: var(--bg-slate);
  height: 100%;
}

.category-title {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  letter-spacing: 0.3rpx;
}

.dish-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: var(--radius-xl);
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.02);
}

.dish-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--bg-slate);
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin: 8rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  word-break: break-all;
}

.dish-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

/* 加减按钮 */
.dish-action {
  display: flex;
  align-items: center;
}

.minus, .plus {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 50%;
}

.minus {
  border: 2rpx solid var(--border-color);
  color: var(--text-muted);
}

.plus {
  background: var(--primary);
  color: #fff;
}

.count {
  margin: 0 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.bottom-placeholder {
  height: 220rpx;
}

/* 购物车栏 (悬浮) */
.cart-bar {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  right: 28rpx;
  height: 100rpx;
  background: var(--text-main);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 36rpx;
  z-index: 100;
  box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.15);
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
  position: relative;
}

.cart-icon {
  font-size: 44rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  left: 44rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.total-price {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  margin-left: 28rpx;
  letter-spacing: 0.5rpx;
}

.submit-btn {
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 44rpx;
  border-radius: 42rpx;
  letter-spacing: 1rpx;
  transition: opacity 0.2s;
}

.submit-btn:active {
  opacity: 0.8;
}

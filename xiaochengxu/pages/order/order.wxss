/* pages/order/order.wxss — admin-web 主题对齐
 * 颜色：#2563EB / #0F172A / #334155 / #64748B / #94A3B8 / #F1F5F9 / #F8FAFC / #E5E7EB / #EFF6FF
 * 圆角：rounded-lg=16rpx (8px) / rounded-xl=24rpx (12px) / rounded-2xl=32rpx (16px)
 * 阴影：shadow-sm=0 2rpx 4rpx 0 rgba(0,0,0,.04)
 */

/* ====== 页面 ====== */
.om-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F8FAFC;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  color: #0F172A;
  font-size: 28rpx;
  line-height: 1.5;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ====== 顶部桌号 / 扫码栏 ====== */
.om-topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F1F5F9;
}
.om-topbar-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}
.om-table-num {
  font-size: 38rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}
.om-table-suffix {
  font-size: 22rpx;
  color: #94A3B8;
}

/* 扫码提示（无桌号态）*/
.om-scan-hint {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 20rpx 8rpx 14rpx;
  background: #EFF6FF;
  border-radius: 12rpx;
}
.om-scan-icon {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.om-scan-icon-line {
  width: 22rpx;
  height: 2rpx;
  background: #2563EB;
  border-radius: 2rpx;
}
.om-scan-icon-line-mid { width: 14rpx; }
.om-scan-hint-text {
  font-size: 26rpx;
  color: #2563EB;
  font-weight: 500;
}
.om-scan-hint-arrow {
  font-size: 30rpx;
  color: #2563EB;
  line-height: 1;
}

.om-rescan {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  background: #F1F5F9;
  color: #64748B;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* ====== 主体：左分类 + 右菜品 ====== */
.om-main {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}

/* 左侧分类 */
.om-cat {
  width: 160rpx;
  background: #FFFFFF;
  border-right: 2rpx solid #F1F5F9;
  height: 100%;
}
.om-cat-item {
  position: relative;
  padding: 26rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s, color 0.15s;
}
.om-cat-text {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}
.om-cat-item-active {
  background: #F8FAFC;
}
.om-cat-item-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 36rpx;
  background: #2563EB;
  border-radius: 0 4rpx 4rpx 0;
}
.om-cat-item-active .om-cat-text {
  color: #2563EB;
  font-weight: 600;
}

/* 右侧菜品 */
.om-dish {
  flex: 1;
  height: 100%;
  background: #F8FAFC;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}
.om-dish-cat-title {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
  padding: 0 4rpx 12rpx;
  letter-spacing: 0.5rpx;
}

/* 菜品卡 */
.om-dish-card {
  display: flex;
  padding: 18rpx;
  margin-bottom: 14rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.04);
  gap: 18rpx;
}
.om-dish-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #F8FAFC;
  display: block;
}
.om-dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8rpx;
}
.om-dish-name-row {
  display: flex;
  align-items: center;
}
.om-dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  letter-spacing: 0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.om-dish-desc {
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}
.om-dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}
.om-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.om-price-symbol {
  font-size: 22rpx;
  font-weight: 600;
  color: #0F172A;
}
.om-price-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: 0.3rpx;
}

/* 步进器（admin-web 同款 8px 圆角矩形按钮，不是圆球） */
.om-step {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.om-step-minus,
.om-step-plus {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  border-radius: 12rpx;
  font-weight: 500;
  transition: opacity 0.15s, background 0.15s;
}
.om-step-minus {
  background: #F1F5F9;
  color: #334155;
  border: 2rpx solid #E5E7EB;
}
.om-step-minus-hover { background: #E2E8F0; }
.om-step-plus {
  background: #2563EB;
  color: #FFFFFF;
}
.om-step-plus-hover { background: #1D4ED8; }
.om-step-count {
  min-width: 56rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #2563EB;
  padding: 0 10rpx;
  background: #EFF6FF;
  border: 2rpx solid #BFDBFE;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.om-bottom-spacer {
  height: 240rpx;
}

/* ====== 悬浮购物车栏 ====== */
.om-cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  background: #FFFFFF;
  border: 2rpx solid #F1F5F9;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 24rpx;
  z-index: 100;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}
.om-cart-bar-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}
.om-cart-bar-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EFF6FF;
  border-radius: 50%;
  flex-shrink: 0;
}
.om-cart-bar-icon-glyph {
  display: none;
}

/* 购物车线条图标（admin-web ShoppingCart 简化版） */
.om-icon-cart-mini {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.om-icon-cart-mini-handle {
  position: absolute;
  top: 4rpx;
  left: 0;
  width: 10rpx;
  height: 3rpx;
  background: #2563EB;
  border-radius: 2rpx;
}
.om-icon-cart-mini-body {
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  width: 28rpx;
  height: 18rpx;
  border: 3rpx solid #2563EB;
  border-radius: 4rpx 6rpx 4rpx 4rpx;
  box-sizing: border-box;
}
.om-icon-cart-mini-wheel {
  position: absolute;
  bottom: 2rpx;
  left: 8rpx;
  width: 6rpx;
  height: 6rpx;
  background: #2563EB;
  border-radius: 50%;
}
.om-icon-cart-mini-wheel-2 { left: 22rpx; }
.om-cart-bar-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #EF4444;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  box-sizing: border-box;
  border: 4rpx solid #FFFFFF;
}
.om-cart-bar-amount {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  min-width: 0;
}
.om-cart-bar-symbol {
  font-size: 24rpx;
  font-weight: 600;
  color: #0F172A;
}
.om-cart-bar-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #2563EB;
  letter-spacing: 0.5rpx;
}
.om-cart-bar-submit {
  flex-shrink: 0;
  height: 80rpx;
  padding: 0 36rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5rpx;
}
.om-cart-bar-submit-hover {
  background: #1D4ED8;
}

/* ====== 数量输入弹窗 ====== */
.om-qty-modal {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.om-qty-card {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.2);
  overflow: hidden;
}
.om-qty-head {
  padding: 32rpx 32rpx 20rpx;
  text-align: center;
  border-bottom: 2rpx solid #F1F5F9;
}
.om-qty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  display: block;
  margin-bottom: 8rpx;
}
.om-qty-dish {
  font-size: 24rpx;
  color: #64748B;
}
.om-qty-body {
  padding: 28rpx 32rpx 32rpx;
}
.om-qty-ctrl {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.om-qty-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #F1F5F9;
  color: #334155;
  border: 2rpx solid #E5E7EB;
  font-size: 36rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.om-qty-input {
  width: 160rpx;
  height: 80rpx;
  border: 2rpx solid #2563EB;
  border-radius: 16rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
}
.om-qty-quick {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}
.om-qty-quick-btn {
  padding: 12rpx 28rpx;
  background: #F1F5F9;
  color: #334155;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 2rpx solid #E5E7EB;
}
.om-qty-quick-btn-danger {
  color: #EF4444;
  border-color: #FEE2E2;
  background: #FEF2F2;
}
.om-qty-foot {
  display: flex;
  border-top: 2rpx solid #F1F5F9;
}
.om-qty-cancel,
.om-qty-confirm {
  flex: 1;
  height: 96rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 0;
  line-height: 96rpx;
  text-align: center;
}
.om-qty-cancel {
  color: #64748B;
  border-right: 2rpx solid #F1F5F9;
}
.om-qty-confirm {
  color: #2563EB;
  font-weight: 600;
}
.om-qty-cancel::after,
.om-qty-confirm::after {
  border: none;
}


/* ====== 购物车弹窗 ====== */
.om-cart-modal {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}
.om-cart-sheet {
  width: 100%;
  max-height: 80vh;
  background: #F8FAFC;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.15);
}
.om-cart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F1F5F9;
}
.om-cart-head-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.om-cart-head-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}
.om-cart-head-meta {
  font-size: 22rpx;
  color: #94A3B8;
}
.om-cart-head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.om-cart-clear {
  height: 56rpx;
  padding: 0 22rpx;
  background: #FEF2F2;
  color: #EF4444;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  border: 2rpx solid #FEE2E2;
}
.om-cart-clear-hover { background: #FEE2E2; }
.om-cart-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #F1F5F9;
  color: #64748B;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.om-cart-close-hover { background: #E2E8F0; }

/* 列表 */
.om-cart-list {
  flex: 1;
  padding: 16rpx 32rpx 0;
  min-height: 200rpx;
}
.om-cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 60rpx;
  gap: 12rpx;
}
.om-cart-empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
}
.om-cart-empty-desc {
  font-size: 24rpx;
  color: #94A3B8;
}

.om-cart-row {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.04);
}
.om-cart-row-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #F8FAFC;
  flex-shrink: 0;
  display: block;
}
.om-cart-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 6rpx;
}
.om-cart-row-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.om-cart-row-price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.om-cart-row-price-symbol {
  font-size: 22rpx;
  color: #64748B;
}
.om-cart-row-price-num {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}
.om-cart-row-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}
.om-cart-row-subtotal {
  font-size: 30rpx;
  font-weight: 700;
  color: #2563EB;
  letter-spacing: 0.3rpx;
}

/* 底部 */
.om-cart-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #F1F5F9;
}
.om-cart-foot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.om-cart-foot-count {
  font-size: 22rpx;
  color: #94A3B8;
}
.om-cart-foot-amount {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.om-cart-foot-symbol {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F172A;
}
.om-cart-foot-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2563EB;
  letter-spacing: 0.5rpx;
  line-height: 1.1;
}
.om-cart-foot-submit {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 48rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5rpx;
}
.om-cart-foot-submit-hover {
  background: #1D4ED8;
}

/* pages/order/order.wxss */
.order-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  background: #f8f8f8;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 未扫码提示 */
.scan-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff3e0;
  border-bottom: 1rpx solid #ffe0b2;
  flex-shrink: 0;
}

.prompt-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.prompt-text {
  flex: 1;
  font-size: 26rpx;
  color: #e65100;
  font-weight: 500;
}

.prompt-arrow {
  font-size: 32rpx;
  color: #e65100;
  margin-left: 8rpx;
}

/* 顶部桌号栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #fff;
  flex-shrink: 0;
}

.table-info {
  display: flex;
  align-items: baseline;
}

.table-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-right: 6rpx;
}

.table-label {
  font-size: 22rpx;
  color: #999;
}

.scan-entry {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
}

/* 主体内容区 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
  border-top: 1rpx solid #f0f0f0;
}

.category-list {
  width: 140rpx;
  background: #f7f7f7;
  height: 100%;
}

.category-item {
  padding: 30rpx 8rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  border-left: 5rpx solid transparent;
}

.category-item.active {
  color: #ff9d00;
  font-weight: bold;
  background: #fff;
  border-left-color: #ff9d00;
}

.dish-list {
  flex: 1;
  padding: 16rpx;
  background: #fff;
  height: 100%;
}

.category-title {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.dish-item {
  display: flex;
  padding: 16rpx 8rpx;
  margin-bottom: 20rpx;
}

.dish-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f9f9f9;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.dish-desc {
  font-size: 20rpx;
  color: #999;
  margin: 6rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

/* 加减按钮 */
.dish-action {
  display: flex;
  align-items: center;
}

.minus, .plus {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 50%;
}

.minus {
  border: 2rpx solid #ddd;
  color: #999;
}

.plus {
  background: #ff9d00;
  color: #fff;
}

.count {
  margin: 0 16rpx;
  font-size: 28rpx;
}

.bottom-placeholder {
  height: 200rpx;
}

/* 购物车栏 (悬浮) */
.cart-bar {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  right: 24rpx;
  height: 90rpx;
  background: rgba(0, 0, 0, 0.85);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  z-index: 100;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.2);
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
  position: relative;
}

.cart-icon {
  font-size: 40rpx;
}

.badge {
  position: absolute;
  top: -12rpx;
  left: 38rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
}

.total-price {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 24rpx;
}

.submit-btn {
  background: #ff9d00;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 40rpx;
  margin-right: -30rpx;
  border-radius: 0 45rpx 45rpx 0;
}

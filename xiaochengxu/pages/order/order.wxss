/* pages/order/order.wxss */
.order-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  background: #f7f7f7;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 未扫码提示 */
.scan-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.prompt-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.prompt-text {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

.prompt-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 顶部桌号栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  flex-shrink: 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-info {
  display: flex;
  align-items: baseline;
}

.table-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-right: 8rpx;
  letter-spacing: 1rpx;
}

.table-label {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 0.3rpx;
}

.scan-entry {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  letter-spacing: 0.3rpx;
}

/* 主体内容区 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-list {
  width: 150rpx;
  background: #fff;
  height: 100%;
  border-right: 1rpx solid #f0f0f0;
}

.category-item {
  padding: 36rpx 12rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  border-left: 6rpx solid transparent;
  letter-spacing: 0.3rpx;
}

.category-item.active {
  color: #1a1a1a;
  font-weight: 600;
  background: #f7f7f7;
  border-left-color: #1a1a1a;
}

.dish-list {
  flex: 1;
  padding: 20rpx;
  background: #f7f7f7;
  height: 100%;
}

.category-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  letter-spacing: 0.3rpx;
}

.dish-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
}

.dish-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.3rpx;
}

.dish-desc {
  font-size: 22rpx;
  color: #999;
  margin: 8rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.dish-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

/* 加减按钮 */
.dish-action {
  display: flex;
  align-items: center;
}

.minus, .plus {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 50%;
}

.minus {
  border: 2rpx solid #e0e0e0;
  color: #999;
}

.plus {
  background: #1a1a1a;
  color: #fff;
}

.count {
  margin: 0 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.bottom-placeholder {
  height: 220rpx;
}

/* 购物车栏 (悬浮) */
.cart-bar {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  right: 28rpx;
  height: 100rpx;
  background: #1a1a1a;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 36rpx;
  z-index: 100;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
  position: relative;
}

.cart-icon {
  font-size: 44rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  left: 44rpx;
  background: #fff;
  color: #1a1a1a;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.total-price {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  margin-left: 28rpx;
  letter-spacing: 0.5rpx;
}

.submit-btn {
  background: #fff;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 600;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 44rpx;
  margin-right: -8rpx;
  border-radius: 0 42rpx 42rpx 0;
  letter-spacing: 1rpx;
}

/* pages/order/order.wxss */
.order-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
  background: #f8f8f8;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 顶部桌号栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 30rpx;
  background: #fff;
  flex-shrink: 0;
}

.table-info {
  display: flex;
  align-items: baseline;
}

.table-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-right: 8rpx;
}

.table-label {
  font-size: 24rpx;
  color: #999;
}

.scan-entry {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* 主体内容区 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
  border-top: 1rpx solid #f0f0f0;
}

.category-list {
  width: 160rpx;
  background: #f7f7f7;
  height: 100%;
}

.category-item {
  padding: 40rpx 10rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  border-left: 6rpx solid transparent;
}

.category-item.active {
  color: #ff9d00;
  font-weight: bold;
  background: #fff;
  border-left-color: #ff9d00;
}

.dish-list {
  flex: 1;
  padding: 20rpx;
  background: #fff;
  height: 100%;
}

.category-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.dish-item {
  display: flex;
  padding: 20rpx 10rpx;
  margin-bottom: 30rpx;
}

.dish-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f9f9f9;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.dish-desc {
  font-size: 22rpx;
  color: #999;
  margin: 8rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

/* 加减按钮 */
.dish-action {
  display: flex;
  align-items: center;
}

.minus, .plus {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 50%;
}

.minus {
  border: 2rpx solid #ddd;
  color: #999;
}

.plus {
  background: #ff9d00;
  color: #fff;
}

.count {
  margin: 0 20rpx;
  font-size: 30rpx;
}

.bottom-placeholder {
  height: 200rpx;
}

/* 购物车栏 (悬浮) */
.cart-bar {
  position: fixed;
  bottom: 20rpx;
  left: 30rpx;
  right: 30rpx;
  height: 100rpx;
  background: rgba(0, 0, 0, 0.85);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  z-index: 100;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
  position: relative;
}

.cart-icon {
  font-size: 44rpx;
}

.badge {
  position: absolute;
  top: -15rpx;
  left: 45rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.total-price {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-left: 30rpx;
}

.submit-btn {
  background: #ff9d00;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 50rpx;
  margin-right: -40rpx;
  border-radius: 0 50rpx 50rpx 0;
}

<!--pages/orders-list/orders-list.wxml — 真页面：订单列表-->
<view class="om-page">
  <!-- 自绘顶栏：状态栏占位 + navbar -->
  <view class="om-navbar" style="padding-top: {{statusBarHeight || 20}}px;">
    <view class="om-navbar-inner">
      <view class="om-navbar-back" bindtap="onBack" hover-class="om-navbar-back-hover">
        <text class="om-navbar-back-arrow">‹</text>
      </view>
      <text class="om-navbar-title">订单</text>
    </view>
  </view>

  <!-- 状态筛选 Tabs -->
  <scroll-view class="om-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="om-tabs-inner">
      <view class="om-tab {{currentTab === 'all' ? 'om-tab-active' : ''}}" bindtap="switchTab" data-tab="all"><text>全部</text></view>
      <view class="om-tab {{currentTab === 'draft' ? 'om-tab-active' : ''}}" bindtap="switchTab" data-tab="draft"><text>待提交</text></view>
      <view class="om-tab {{currentTab === 'submitted' ? 'om-tab-active' : ''}}" bindtap="switchTab" data-tab="submitted"><text>已提交</text></view>
      <view class="om-tab {{currentTab === 'settled' ? 'om-tab-active' : ''}}" bindtap="switchTab" data-tab="settled"><text>已完成</text></view>
      <view class="om-tab {{currentTab === 'cancelled' ? 'om-tab-active' : ''}}" bindtap="switchTab" data-tab="cancelled"><text>已取消</text></view>
    </view>
  </scroll-view>

  <!-- 列表 -->
  <scroll-view
    class="om-list"
    scroll-y
    enhanced
    show-scrollbar="{{true}}"
    refresher-enabled
    refresher-triggered="{{_refreshing}}"
    bindrefresherrefresh="onScrollRefresh"
    bindscrolltolower="onScrolltolower"
    lower-threshold="200"
  >
    <view wx:if="{{isLoading && filteredOrders.length === 0}}" class="om-skeleton-list">
      <view class="om-skeleton-card" wx:for="{{[0,1,2]}}" wx:key="*this">
        <view class="om-skeleton-row">
          <view class="om-skeleton-thumb"></view>
          <view class="om-skeleton-main">
            <view class="om-skeleton-line om-skeleton-line-mid"></view>
            <view class="om-skeleton-line om-skeleton-line-short"></view>
          </view>
        </view>
        <view class="om-skeleton-foot">
          <view class="om-skeleton-line-foot"></view>
          <view class="om-skeleton-line-foot"></view>
        </view>
      </view>
    </view>

    <view class="om-empty" wx:elif="{{filteredOrders.length === 0 && !isLoading}}">
      <view class="om-empty-icon">
        <view class="om-icon-list-empty">
          <view class="om-icon-list-empty-line"></view>
          <view class="om-icon-list-empty-line"></view>
          <view class="om-icon-list-empty-line"></view>
        </view>
      </view>
      <view class="om-empty-title"><text>暂无订单</text></view>
      <view class="om-empty-desc"><text>快去扫码点餐吧</text></view>
    </view>

    <block wx:for="{{filteredOrders}}" wx:key="id" wx:for-index="orderIndex">
      <view class="om-card" bindtap="goToDetail" data-id="{{item.id}}" hover-class="om-card-hover" hover-stay-time="80">
        <view class="om-store" wx:if="{{storeInfo && storeInfo.store_name}}">
          <image
            wx:if="{{storeInfo.store_avatar}}"
            class="om-store-avatar"
            src="{{storeInfo.store_avatar}}"
            mode="aspectFill"
          />
          <view wx:else class="om-store-avatar om-store-avatar-empty">
            <text class="om-store-avatar-letter">{{storeInfo.store_name_letter}}</text>
          </view>
          <text class="om-store-name">{{storeInfo.store_name}}</text>
        </view>

        <view class="om-head">
          <image
            wx:if="{{item.firstDishImage}}"
            class="om-head-thumb"
            src="{{item.firstDishImage}}"
            mode="aspectFill"
          />
          <view wx:else class="om-head-thumb om-head-thumb-empty"></view>
          <view class="om-head-main">
            <view class="om-head-row1">
              <view class="om-table-wrap">
                <block wx:if="{{item.order_type === 'takeaway'}}">
                  <text class="om-takeaway-tag">🛍 {{item.pickup_no ? ('外带 ' + item.pickup_no + '号') : '外带'}}</text>
                </block>
                <block wx:else>
                  <text class="om-table-num">{{item.tableNumber || item.table_id || '-'}}</text>
                  <text class="om-table-suffix">桌</text>
                </block>
              </view>
              <view class="om-status om-status-{{item.status}}"><text>{{statusMap[item.status]}}</text></view>
            </view>
            <view class="om-meta">
              <text class="om-time">{{item.created_at}}</text>
            </view>
          </view>
        </view>

        <view
          class="om-summary"
          wx:if="{{!expandedMap[item.id] && item.order_items.length > 0}}"
          catchtap="toggleExpand"
          data-id="{{item.id}}"
        >
          <text class="om-summary-text">{{item.summaryText}}</text>
          <view class="om-summary-trail">
            <text class="om-summary-count">共{{item.totalItems}}件</text>
            <text class="om-summary-arrow">›</text>
          </view>
        </view>

        <view class="om-detail" wx:if="{{expandedMap[item.id]}}">
          <view
            class="om-detail-group"
            wx:for="{{item.groupedItems}}"
            wx:for-item="group"
            wx:for-index="gi"
            wx:key="label"
          >
            <view class="om-group-head">
              <text class="om-group-label {{gi === 0 ? 'om-group-label-primary' : 'om-group-label-warn'}}">{{group.label}}</text>
              <view class="om-group-line"></view>
              <text class="om-group-time">{{group.time}}</text>
            </view>
            <view class="om-group-body">
              <view class="om-item-row" wx:for="{{group.items}}" wx:for-item="dish" wx:key="id">
                <view class="om-item-name-wrap">
                  <text class="om-item-name">{{dish.dish_name}}</text>
                  <text class="om-item-spec" wx:if="{{dish.spec_name}}">({{dish.spec_name}})</text>
                  <text class="om-item-qty">×{{dish.quantity}}</text>
                </view>
                <text class="om-item-subtotal">¥{{dish.subtotal}}</text>
              </view>
            </view>
          </view>

          <view class="om-remark" wx:if="{{item.remark}}"><text>备注：{{item.remark}}</text></view>

          <view class="om-collapse" catchtap="toggleExpand" data-id="{{item.id}}">
            <text>收起明细</text>
          </view>
        </view>

        <view class="om-footer">
          <view class="om-total">
            <text class="om-total-label">合计</text>
            <text class="om-total-amount">¥{{item.total_amount}}</text>
          </view>
          <view class="om-actions">
            <view class="om-btn om-btn-secondary" catchtap="goToDetail" data-id="{{item.id}}"><text>详情</text></view>
            <view
              class="om-btn om-btn-success"
              wx:if="{{item.status === 'settled'}}"
              catchtap="reorder"
              data-id="{{item.id}}"
            ><text>再来一单</text></view>
          </view>
        </view>
      </view>

      <view class="om-separator" wx:if="{{orderIndex < filteredOrders.length - 1}}">
        <view class="om-separator-line"></view>
        <view class="om-separator-dot"></view>
        <view class="om-separator-line"></view>
      </view>
    </block>

    <view class="om-loading" wx:if="{{isLoadingMore}}">
      <view class="om-spinner"></view>
      <text>加载更多</text>
    </view>

    <view
      class="om-end-tip"
      wx:if="{{!isLoading && !isLoadingMore && !hasMore && filteredOrders.length > 0}}"
    ><text>— 没有更多订单了 —</text></view>
  </scroll-view>
</view>
